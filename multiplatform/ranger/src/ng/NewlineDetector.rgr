Import "TokenDetector.rgr"

class NewlineDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "newline"
    }

    sfn create:NewlineDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new NewlineDetector(s))
    }

    fn isNewline:boolean (ch:int) {
        if (ch == 10) {
            return true
        }
        if (ch == 13) {
            return true
        }
        return false
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        if ((slice.length()) == 0) {
            return (this.noMatch())
        }

        def i@(mutable):int 0
        while (i < (slice.length())) {
            def ch (slice.charCodeAt(i))
            if (this.isNewline(ch)) {
                i = i + 1
            } {
                break
            }
        }

        if (i == 0) {
            return (this.noMatch())
        }

        def out (slice.read(i))
        out.tag = detectedTag
        return out
    }
}
