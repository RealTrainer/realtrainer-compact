Import "TokenDetector.rgr"
Import "DateTimeValue.rgr"
Import "SliceParsedValue.rgr"

class DateTimeDetector {
    Extends(TokenDetector)

    ; Cache of previously parsed date time values for slices
    def sliceMap:[TokenSlice:DateTimeValue]
    def sliceHitMap:[TokenSlice:TokenSlice]
    def parseDateShapeCalls:int 0

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "datetime"
    }

    sfn create:DateTimeDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new DateTimeDetector(s))
    }

    fn parseToMap:TokenSlice (slice:TokenSlice) {
        if (has sliceMap slice) {
            def cachedHit@(optional):TokenSlice (get sliceHitMap slice)
            if (!null? cachedHit) {
                def hit (unwrap cachedHit)
                def cachedVal@(optional):DateTimeValue (get sliceMap slice)
                if (!null? cachedVal) {
                    def payload (SliceParsedValue.fromDateTime((unwrap cachedVal)))
                    hit.setSliceValue(payload)
                    slice.setSliceValue(payload)
                }
                return hit
            }
            return (this.noMatch())
        }

        def newSlice ( this.parseDateShape(slice) )
        return newSlice
    }

    fn getParseDateShapeCalls:int () {
        return parseDateShapeCalls
    }

    fn hasCachedValue:boolean (slice:TokenSlice) {
        return (has sliceMap slice)
    }

    fn parseDateShape:TokenSlice (slice:TokenSlice) {
        parseDateShapeCalls = parseDateShapeCalls + 1

        if (slice.hasInteger(0 3)) {
        } {
            return (this.noMatch())
        }

        if ((slice.charCodeAt(4)) != 45) {
            return (this.noMatch())
        }   

        ; length of the parsed slice
        def plen:int 0
        def out (new DateTimeValue)
        out.year = (slice.parseInteger(0 3))

        if (slice.hasInteger(5 6)) {
            out.month = (slice.parseInteger(5 6))
        } {
            return (this.noMatch())
        }

        if ((slice.charCodeAt(7)) != 45) {
            return (this.noMatch())
        }

        if (slice.hasInteger(8 9)) {
            out.day = (slice.parseInteger(8 9))
        } {
            return (this.noMatch())
        }

        if (out.month < 1) {
            return (this.noMatch())
        }
        if (out.month > 12) {
            return (this.noMatch())
        }
        if (out.day < 1) {
            return (this.noMatch())
        }
        if (out.day > 31) {
            return (this.noMatch())
        }

        ; YYYY-MM-DD is 10 characters long
        plen = 10

        ; optional time part starts with 'T'
        if ((slice.charCodeAt(10)) == 84) {

            if (slice.hasInteger(11 12)) {
                out.hour = (slice.parseInteger(11 12))
            } {
                return (this.noMatch())
            }

            if ((slice.charCodeAt(13)) != 58) {
                return (this.noMatch())
            }

            if (slice.hasInteger(14 15)) {
                out.minute = (slice.parseInteger(14 15))
            } {
                return (this.noMatch())
            }

            if (out.hour < 0) {
                return (this.noMatch())
            }
            if (out.hour > 23) {
                return (this.noMatch())
            }
            if (out.minute < 0) {
                return (this.noMatch())
            }
            if (out.minute > 59) {
                return (this.noMatch())
            }

            def idx@(mutable):int 16
            if (((slice.length()) >= 19) && ((slice.charCodeAt(16)) == 58)) {
                out.second = (slice.parseInteger(17 18))
                if (out.second < 0) {
                    return (this.noMatch())
                }
                if (out.second > 59) {
                    return (this.noMatch())
                }
                idx = 19
            }

            if (idx < (slice.length())) {
                def tzCh (slice.charCodeAt(idx))
                if (tzCh == 90) {
                    out.timezone = "Z"
                    idx = idx + 1
                }

                if ((tzCh == 43) || (tzCh == 45)) {
                    if ((idx + 6) <= (slice.length())) {
                        if (slice.hasInteger((idx + 1) (idx + 2))) {
                        } {
                            return (this.noMatch())
                        }
                        if ((slice.charCodeAt(idx + 3)) != 58) {
                            return (this.noMatch())
                        }
                        if (slice.hasInteger((idx + 4) (idx + 5))) {
                        } {
                            return (this.noMatch())
                        }

                        def tzHour (slice.parseInteger((idx + 1) (idx + 2)))
                        def tzMin (slice.parseInteger((idx + 4) (idx + 5)))
                        if (tzHour < 0) {
                            return (this.noMatch())
                        }
                        if (tzHour > 23) {
                            return (this.noMatch())
                        }
                        if (tzMin < 0) {
                            return (this.noMatch())
                        }
                        if (tzMin > 59) {
                            return (this.noMatch())
                        }

                        def tzSlice (slice.read(idx + 6))
                        out.timezone = ((tzSlice.peek(idx)).toString())
                        idx = idx + 6
                    }
                }
            }

            plen = idx
        }

        ; create new slice 0, plen
        def newSlice (slice.read(plen))
        newSlice.tag = detectedTag
        def payload2 (SliceParsedValue.fromDateTime(out))
        newSlice.setSliceValue(payload2)
        slice.setSliceValue(payload2)

        ; add both the slice and the new value to the map
        ; so that we can detect the same slice faster next time
        set sliceMap newSlice out
        set sliceMap slice out
        set sliceHitMap newSlice newSlice
        set sliceHitMap slice newSlice
        return newSlice
    }



    fn detect:TokenSlice (slice:TokenSlice) {
        return (this.parseToMap(slice))
    }
}
