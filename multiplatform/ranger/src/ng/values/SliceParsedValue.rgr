        out.kind = "percentage"
        out.percentage = value
        return out
    }

    sfn fromRecoveryTime:SliceParsedValue (value:RecoveryTimeValue) {
        def out (new SliceParsedValue)
        out.kind = "recovery-time"
        out.recoveryTime = value
        return out
    }

    sfn fromWeight:SliceParsedValue (value:WeightValue) {
        def out (new SliceParsedValue)
        out.kind = "weight"
        out.weight = value
        return out
    }

    sfn fromNumRange:SliceParsedValue (value:NumRangeValue) {
        def out (new SliceParsedValue)
        out.kind = "num-range"
        out.numRange = value
        return out
    }

    sfn fromPercentageRange:SliceParsedValue (value:PercentageRangeValue) {
        def out (new SliceParsedValue)
        out.kind = "percentage-range"
