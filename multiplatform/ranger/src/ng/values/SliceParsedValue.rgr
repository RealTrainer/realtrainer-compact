        out.kind = "zone"
        out.zone = value
        return out
    }

    sfn fromPositiveInteger:SliceParsedValue (value:PositiveIntegerValue) {
        def out (new SliceParsedValue)
        out.kind = "positive-integer"
        out.positiveInteger = value
        return out
    }

    sfn fromDetailsLevel:SliceParsedValue (value:DetailsLevelValue) {
        def out (new SliceParsedValue)
        out.kind = "details-level"
        out.detailsLevel = value
        return out
    }

    sfn fromRecovery:SliceParsedValue (value:RecoveryValue) {
        def out (new SliceParsedValue)
        out.kind = "recovery"
        out.recovery = value
        return out
    }

    sfn fromTimeValue:SliceParsedValue (value:TimeValueValue) {
        def out (new SliceParsedValue)
        out.kind = "time-value"
