Import "values/DateTimeValue.rgr"
Import "values/DistanceValue.rgr"
Import "values/PercentageValue.rgr"
Import "values/RecoveryTimeValue.rgr"
Import "values/WeightValue.rgr"
Import "values/NumRangeValue.rgr"
Import "values/PercentageRangeValue.rgr"
Import "values/RepeatBlockValue.rgr"
Import "values/ZoneValue.rgr"
Import "values/PositiveIntegerValue.rgr"
Import "values/DetailsLevelValue.rgr"
Import "values/RecoveryValue.rgr"
Import "values/TimeValueValue.rgr"
Import "values/LeftRightValue.rgr"
Import "values/FeelingValue.rgr"
Import "values/EffortValue.rgr"
Import "values/BodyMetricValue.rgr"
Import "values/CircuitValue.rgr"
Import "values/ContextEntryValue.rgr"
Import "values/DurationValue.rgr"

class SliceParsedValue {
    ; Discriminator for the active payload type.
    def kind:string ""

    ; Concrete payloads (optional, exactly one should be set for a given kind).
    def dateTime@(optional):DateTimeValue
    def distance@(optional):DistanceValue
    def percentage@(optional):PercentageValue
    def recoveryTime@(optional):RecoveryTimeValue
    def weight@(optional):WeightValue
    def numRange@(optional):NumRangeValue
    def percentageRange@(optional):PercentageRangeValue
    def repeatBlock@(optional):RepeatBlockValue
    def zone@(optional):ZoneValue
    def positiveInteger@(optional):PositiveIntegerValue
    def detailsLevel@(optional):DetailsLevelValue
    def recovery@(optional):RecoveryValue
    def timeValue@(optional):TimeValueValue
    def leftRight@(optional):LeftRightValue
    def feeling@(optional):FeelingValue
    def effort@(optional):EffortValue
    def bodyMetric@(optional):BodyMetricValue
    def circuit@(optional):CircuitValue
    def contextEntry@(optional):ContextEntryValue
    def duration@(optional):DurationValue

    sfn create:SliceParsedValue (kind:string) {
        def out (new SliceParsedValue)
        out.kind = kind
        return out
    }

    sfn fromDateTime:SliceParsedValue (value:DateTimeValue) {
        def out (new SliceParsedValue)
        out.kind = "datetime"
        out.dateTime = value
        return out
    }

    sfn fromDistance:SliceParsedValue (value:DistanceValue) {
        def out (new SliceParsedValue)
        out.kind = "distance"
        out.distance = value
        return out
    }

    sfn fromPercentage:SliceParsedValue (value:PercentageValue) {
