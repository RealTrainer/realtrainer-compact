        out.kind = "body-metric"
        out.bodyMetric = value
        return out
    }

    sfn fromCircuit:SliceParsedValue (value:CircuitValue) {
        def out (new SliceParsedValue)
        out.kind = "circuit"
        out.circuit = value
        return out
