Import "TokenDetector.rgr"
Import "PercentageValue.rgr"
Import "SliceParsedValue.rgr"

class PercentageDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "percentage"
    }

    sfn create:PercentageDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new PercentageDetector(s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 2) {
            return (this.noMatch())
        }
        def valuePart (slice.splitWithToken("%"))
        def vLen (valuePart.length())
        if (vLen <= 0) {
            return (this.noMatch())
        }
        if ((vLen + 1) > len) {
            return (this.noMatch())
        }
        if (valuePart.hasInteger(0 (vLen - 1))) {
        } {
            return (this.noMatch())
        }
        def v (valuePart.parseInteger(0 (vLen - 1)))
        if (v <= 0) {
            return (this.noMatch())
        }
        if ((slice.charCodeAt(vLen)) != 37) {
            return (this.noMatch())
        }

        def out (slice.read(vLen + 1))
        out.tag = detectedTag
        def pv (new PercentageValue)
        pv.value = v
        def payload (SliceParsedValue.fromPercentage(pv))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)
        return out
    }
}
