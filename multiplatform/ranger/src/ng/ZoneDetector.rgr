Import "TokenDetector.rgr"
Import "ZoneValue.rgr"
Import "SliceParsedValue.rgr"

class ZoneDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "zone"
    }

    sfn create:ZoneDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new ZoneDetector(s))
    }

    fn isDigit:boolean (ch:int) {
        return ((ch >= 48) && (ch <= 57))
    }

    fn isAlphaNum:boolean (ch:int) {
        if ((ch >= 48) && (ch <= 57)) {
            return true
        }
        if ((ch >= 65) && (ch <= 90)) {
            return true
        }
        if ((ch >= 97) && (ch <= 122)) {
            return true
        }
        return false
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        if (slice.hasToken("Zone")) {
        } {
            return (this.noMatch())
        }

        def len (slice.length())
        if (len <= 4) {
            return (this.noMatch())
        }

        def i@(mutable):int 4
        if ((i < len) && ((slice.charCodeAt(i)) == 32)) {
            i = i + 1
        }
        if (i >= len) {
            return (this.noMatch())
        }

        def startDigits i
        while (i < len) {
            def ch (slice.charCodeAt(i))
            if (this.isDigit(ch)) {
                i = i + 1
            } {
                break
            }
        }

        if (i == startDigits) {
            return (this.noMatch())
        }

        def zoneDigits (slice.peek(startDigits).read(i - startDigits))
        if (zoneDigits.hasInteger(0 ((zoneDigits.length()) - 1))) {
        } {
            return (this.noMatch())
        }

        def zoneNum (zoneDigits.parseInteger(0 ((zoneDigits.length()) - 1)))
        if ((zoneNum < 1) || (zoneNum > 5)) {
            return (this.noMatch())
        }

        if (i < len) {
            def next (slice.charCodeAt(i))
            if (this.isAlphaNum(next)) {
                return (this.noMatch())
            }
        }

        def out (slice.read(i))
        out.tag = detectedTag
        def zv (new ZoneValue)
        zv.zone = zoneNum
        def payload (SliceParsedValue.fromZone(zv))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)
        return out
    }
}
