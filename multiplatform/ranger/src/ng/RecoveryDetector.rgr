Import "TokenDetector.rgr"
Import "Parser.rgr"
Import "DistanceDetector.rgr"
Import "RecoveryTimeDetector.rgr"
Import "TimeValueDetector.rgr"
Import "AMTimeValueDetector.rgr"
Import "PercentageDetector.rgr"
Import "WeightDetector.rgr"
Import "NumRangeBlockDetector.rgr"
Import "PositiveIntegerDetector.rgr"
Import "KeywordDetector.rgr"
Import "RecoveryValue.rgr"
Import "SliceParsedValue.rgr"

class RecoveryDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "recovery"
    }

    sfn create:RecoveryDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new RecoveryDetector(s))
    }

    fn isAlphaNum:boolean (ch:int) {
        if ((ch >= 48) && (ch <= 57)) {
            return true
        }
        if ((ch >= 65) && (ch <= 90)) {
            return true
        }
        if ((ch >= 97) && (ch <= 122)) {
            return true
        }
        return false
    }

    fn createChildDetectors:[TokenDetector] () {
        def ds:[TokenDetector]
        push ds (DistanceDetector.create())
        push ds (RecoveryTimeDetector.create())
        push ds (TimeValueDetector.create())
        push ds (AMTimeValueDetector.create())
        push ds (PercentageDetector.create())
        push ds (WeightDetector.create())
        push ds (NumRangeBlockDetector.create())
        push ds (PositiveIntegerDetector.create())
        push ds (KeywordDetector.create("min"))
        push ds (KeywordDetector.create("sec"))
        push ds (KeywordDetector.create("s"))
        push ds (KeywordDetector.create("m"))
        return ds
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def key:string "Recovery"
        def keyLen (strlen key)
        def len (slice.length())
        if (len <= keyLen) {
            return (this.noMatch())
        }

        def head (slice.read(keyLen))
        if (head.strEquals(key)) {
        } {
            return (this.noMatch())
        }

        def next (slice.charCodeAt(keyLen))
        if (this.isAlphaNum(next)) {
            return (this.noMatch())
        }

        def lineEnd@(mutable):int keyLen
        while (lineEnd < len) {
            def ch (slice.charCodeAt(lineEnd))
            if ((ch == 10) || (ch == 13)) {
                break
            }
            lineEnd = lineEnd + 1
        }

        def out (slice.read(lineEnd))
        out.tag = detectedTag

        def labelToken (slice.read(keyLen))
        labelToken.tag = "keyword"
        out.addChild(labelToken)

        def restStart@(mutable):int keyLen
        while (restStart < lineEnd) {
            def ch2 (slice.charCodeAt(restStart))
            if ((ch2 == 32) || (ch2 == 9)) {
                restStart = restStart + 1
            } {
                break
            }
        }

        if (restStart < lineEnd) {
            def rest (slice.peek(restStart).read(lineEnd - restStart))
            def p (new Parser((rest.toString()) (this.createChildDetectors())))
            p.start()
            def children (p.getResults())
            for children ch:TokenSlice i {
                out.addChild(ch)
            }
        }

        def rv (new RecoveryValue)
        rv.label = "Recovery"
        def payload (SliceParsedValue.fromRecovery(rv))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)

        return out
    }
}
