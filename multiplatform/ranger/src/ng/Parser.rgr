

Import "token_slice.rgr"
Import "detectors/DateTimeDetector.rgr"
Import "detectors/TokenDetector.rgr"

class Parser {

    def source:string ""

    def slice:TokenSlice (new TokenSlice("" 0 0))

    def detectors:[TokenDetector]

    def parserdResults:[TokenSlice]
    
    Constructor (source:string, detectors:[TokenDetector]) {
        this.source = source
        this.detectors = detectors
        slice = (new TokenSlice(source 0 (strlen source)))
        clear parserdResults
    }

    ; Zero-copy constructor: takes an existing TokenSlice (window into a parent
    ; source string) instead of allocating a new string. Use this from sub-parsers
    ; in detectors to avoid the .toString() copy + duplicate TokenSlice allocation.
    sfn fromSlice:Parser (s:TokenSlice, detectors:[TokenDetector]) {
        def p (new Parser("" detectors))
        p.slice = s
        return p
    }

    fn start:void () {

        def activeSlice@(mutable):TokenSlice (new TokenSlice("" 0 0))
        activeSlice = slice

        while ((activeSlice.length()) > 0) {
            def advance:int 0

            ; walk detectors and try to parse something
            def i@(mutable):int 0
            while (i < (array_length detectors)) {
                def detector (itemAt detectors i)
                def result (detector.detect(activeSlice))
                if (result.isEmpty()) {
                } {
                    if (result.tag == "space") {
                    } {
                        if (result.tag == "newline") {
                        } {
                            push parserdResults result
                        }
                    }
                    advance = (result.length())
                    break
                }
                i = i + 1
            }
            
            ; TODO: test additional parsers here before deciding fallback move

            ; if no parser matched, it is a syntax error - stop parsing
            if (advance == 0) {
                break
            } {
                activeSlice = (activeSlice.peek(advance))
            }


        }
    }

    fn getResults:[TokenSlice] () {
        return parserdResults
    }

    fn getCount:int () {
        return (array_length parserdResults)
    }

}