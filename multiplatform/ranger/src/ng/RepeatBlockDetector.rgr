Import "TokenDetector.rgr"
Import "RepeatBlockValue.rgr"
Import "SliceParsedValue.rgr"

class RepeatBlockDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "repeat-block"
    }

    sfn create:RepeatBlockDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new RepeatBlockDetector(s))
    }

    fn isDigit:boolean (ch:int) {
        if (ch < 48) {
            return false
        }
        if (ch > 57) {
            return false
        }
        return true
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 2) {
            return (this.noMatch())
        }

        def i@(mutable):int 0
        def hasNonZero@(mutable):boolean false
        while (i < len) {
            def ch (slice.charCodeAt(i))
            if (this.isDigit(ch)) {
                if (ch != 48) {
                    hasNonZero = true
                }
                i = i + 1
            } {
                break
            }
        }

        if (i == 0) {
            return (this.noMatch())
        }
        if (hasNonZero) {
        } {
            return (this.noMatch())
        }
        if (i >= len) {
            return (this.noMatch())
        }
        if ((slice.charCodeAt(i)) != 120) {
            return (this.noMatch())
        }

        def out (slice.read(i + 1))
        out.tag = detectedTag
        def countSlice (slice.read(i))
        def rv (new RepeatBlockValue)
        rv.count = (countSlice.parseInteger(0 (i - 1)))
        def payload (SliceParsedValue.fromRepeatBlock(rv))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)
        return out
    }
}
