    fn toString:string () {
        return (substring source start (start + size))
    }

    fn strEquals:boolean (value:string) {
        def vLen (strlen value)
        if (vLen != size) {
            return false
        }

        def i@(mutable):int 0
        while (i < vLen) {
            if ((charAt source (start + i)) == (charAt value i)) {
            } {
                return false
            }
            i = i + 1
        }

        return true
    }

    fn charCodeAt:int (index:int) {
        if (index < 0) {
            return -1
        }
        if (index >= size) {
            return -1
        }
        return (charAt source (start + index))
    }

    ; Range is inclusive: from..to
    fn hasInteger:boolean (from:int to:int) {
        if (from < 0) {
            return false
        }
        if (to < from) {
            return false
        }
        if (to >= size) {
            return false
        }

        def i@(mutable):int from
        while (i <= to) {
            def ch (this.charCodeAt(i))
            if (ch < 48) {
                return false
            }
            if (ch > 57) {
                return false
            }
            i = i + 1
        }
        return true
    }

    ; Range is inclusive: from..to, returns -1 on invalid input.
    fn parseInteger:int (from:int to:int) {
        if (this.hasInteger(from to)) {
        } {
            return -1
        }

        def value@(mutable):int 0
        def i@(mutable):int from
        while (i <= to) {
            def ch (this.charCodeAt(i))
            value = (value * 10) + (ch - 48)
            i = i + 1
        }
        return value
    }

    ; Range is inclusive: from..to. Accepts optional sign and decimal dot.
    fn hasDouble:boolean (from:int to:int) {
        if (from < 0) {
            return false
        }
        if (to < from) {
            return false
        }
        if (to >= size) {
            return false
        }

        def i@(mutable):int from
        def first (this.charCodeAt(i))
        if ((first == 43) || (first == 45)) {
            i = i + 1
            if (i > to) {
                return false
            }
        }

        def hasDigit@(mutable):boolean false
        def hasDot@(mutable):boolean false

        while (i <= to) {
            def ch (this.charCodeAt(i))
            if ((ch >= 48) && (ch <= 57)) {
                hasDigit = true
                i = i + 1
                continue
            }
            if (ch == 46) {
                if (hasDot) {
                    return false
                }
                hasDot = true
                i = i + 1
                continue
            }
            return false
        }

        return hasDigit
    }

    ; Range is inclusive: from..to, returns 0.0 on invalid input.
    fn parseDouble:double (from:int to:int) {
        if (this.hasDouble(from to)) {
        } {
            return 0.0
        }

        def raw (substring source (start + from) (start + to + 1))
        def v@(optional):double (to_double raw)
        if v {
            return (unwrap v)
        }
        return 0.0
    }

    fn peek:TokenSlice (offset:int) {
        def safeOffset@(mutable):int offset
        if (safeOffset < 0) {
            safeOffset = 0
        }
        if (safeOffset > size) {
            safeOffset = size
        }

        return (new TokenSlice(source (start + safeOffset) (size - safeOffset)))
    }

    fn step:TokenSlice (count:int) {
        return (this.peek(count))
    }

    fn read:TokenSlice (count:int) {
        def safeCount@(mutable):int count
        if (safeCount < 0) {
            safeCount = 0
        }
        if (safeCount > size) {
            safeCount = size
        }

        return (new TokenSlice(source start safeCount))
    }

    fn slice:TokenSlice (count:int) {
        return (this.read(count))
    }

    fn pickSlice:TokenSlice (from:int length:int) {
        return (new TokenSlice(source (start + from) length))
    }

    fn hasToken:boolean (token:string) {
        def tLen (strlen token)
        if (tLen == 0) {
            return true
        }
        if (tLen > size) {
            return false
        }

        def me (this.read(tLen).toString())
        return me == token
    }

    fn endsWith:boolean (token:string) {
        def tLen (strlen token)
        if (tLen == 0) {
            return true
        }
        if (tLen > size) {
            return false
        }

        def me (this.toString())
        def meLen (strlen me)
        return (substring me (meLen - tLen) meLen) == token
    }

    fn findTokenPos:int (token:string) {
        def tLen (strlen token)
        if (tLen == 0) {
            return 0
        }
        if (tLen > size) {
            return -1
        }

        def text (this.toString())
        def maxStart (size - tLen)
        def i@(mutable):int 0
        while (i <= maxStart) {
            if ((substring text i (i + tLen)) == token) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    ; Returns slice before token, e.g. "10kg" splitWithToken("kg") => "10"
    fn splitWithToken:TokenSlice (token:string) {
        def pos (this.findTokenPos(token))
        if (pos < 0) {
            return (new TokenSlice(source start size))
        }
        return (new TokenSlice(source start pos))
    }

    ; Returns slice until token included, e.g. "penkki 10kg kevyt" sliceToToken("kg") => "penkki 10kg"
    fn sliceToToken:TokenSlice (token:string) {
        def pos (this.findTokenPos(token))
        if (pos < 0) {
            return (new TokenSlice(source start size))
        }
        def tLen (strlen token)
        return (new TokenSlice(source start (pos + tLen)))
    }
}
