Import "values/SliceParsedValue.rgr"

class TokenSlice {
    ; TokenSlice stores source + [start,size] window only.
    ; No substring copying is required for peek/read/slice operations.
    ;
    ; Indexing semantics for current ES6 target:
    ; - strlen/substring are runtime string operations
    ; - offsets are UTF-16 code units (not grapheme clusters)
    ; - for example "💪a" has length 3 (2 + 1 code units)
    def source:string ""
    def start:int 0
    def size:int 0
    def tag:string ""
    def children:[TokenSlice]
    def parsedValue@(optional):SliceParsedValue

    Constructor (text:string from:int length:int) {
        source = text

        def textLen (strlen text)
        def safeStart@(mutable):int from
        if (safeStart < 0) {
            safeStart = 0
        }
        if (safeStart > textLen) {
            safeStart = textLen
        }

        def safeLength@(mutable):int length
        if (safeLength < 0) {
            safeLength = 0
        }
        if ((safeStart + safeLength) > textLen) {
            safeLength = (textLen - safeStart)
        }

        start = safeStart
        size = safeLength
    }

    sfn fromText:TokenSlice (text:string) {
        return (new TokenSlice(text 0 (strlen text)))
    }

    fn length:int () {
        return size
    }

    fn childCount:int () {
        return (array_length children)
    }

    fn addChild:void (child:TokenSlice) {
        push children child
    }

    fn getChild:TokenSlice (index:int) {
        return (itemAt children index)
    }

    fn isEmpty:boolean () {
        return size == 0
    }

    fn hasValue:boolean () {
        return size > 0
    }

    fn hasDateTimeValue:boolean () {
        if (!null? parsedValue) {
            def p (unwrap parsedValue)
            if ((p.kind == "datetime") && (p.hasDateTime())) {
                return true
            }
        }
        return false
    }

    fn setSliceValue:void (value:SliceParsedValue) {
        parsedValue = value
    }

    fn hasSliceValue:boolean () {
        return (!null? parsedValue)
    }

    fn getSliceValueKind:string () {
        if (!null? parsedValue) {
            return ((unwrap parsedValue).kind)
        }
        return ""
    }

    fn setDateTimeValue:void (value:DateTimeValue) {
        if (!null? parsedValue) {
            def p (unwrap parsedValue)
            p.dateTime = value
            if ((strlen p.kind) == 0) {
                p.kind = "datetime"
            }
            parsedValue = p
            return
        }
        parsedValue = (SliceParsedValue.fromDateTime(value))
    }

    fn getAsDateTimeValue:DateTimeValue () {
        if (!null? parsedValue) {
            def p (unwrap parsedValue)
            if ((p.kind == "datetime") && (p.hasDateTime())) {
                return (p.getDateTime())
            }
        }
        return (new DateTimeValue)
    }

