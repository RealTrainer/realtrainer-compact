Import "TokenDetector.rgr"
Import "Parser.rgr"
Import "PositiveIntegerDetector.rgr"
Import "KeywordDetector.rgr"

class WeightDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "weight"
    }

    sfn create:WeightDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new WeightDetector(s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 3) {
            return (this.noMatch())
        }

        def detectors:[TokenDetector]
        push detectors (PositiveIntegerDetector.create())
        push detectors (KeywordDetector.create("kg"))

        def p (new Parser((slice.toString()) detectors))
        p.start()
        if ((p.getCount()) != 2) {
            return (this.noMatch())
        }

        def parts (p.getResults())
        def first (itemAt parts 0)
        def second (itemAt parts 1)

        if (!(first.tag == "positive-integer")) {
            return (this.noMatch())
        }
        if (!(second.tag == "keyword")) {
            return (this.noMatch())
        }
        if (!(second.strEquals("kg"))) {
            return (this.noMatch())
        }

        def outLen ((first.length()) + (second.length()))
        def out (slice.read(outLen))
        out.tag = detectedTag
        out.addChild(first)
        out.addChild(second)
        return out
    }
}
