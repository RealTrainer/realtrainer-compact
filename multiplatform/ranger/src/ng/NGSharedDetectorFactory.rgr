Import "detectors/TokenDetector.rgr"
Import "detectors/SpaceDetector.rgr"
Import "detectors/SemicolonSeparatorDetector.rgr"
Import "detectors/NewlineDetector.rgr"
Import "detectors/DateTimeDetector.rgr"
Import "detectors/SpeedDetector.rgr"
Import "detectors/KCALDetector.rgr"
Import "detectors/BPMDetector.rgr"
Import "detectors/WeightDetector.rgr"
Import "detectors/DistanceRangeBlockDetector.rgr"
Import "detectors/PercentageRangeDetector.rgr"
Import "detectors/NumRangeBlockDetector.rgr"
Import "detectors/DistanceDetector.rgr"
Import "detectors/PercentageDetector.rgr"
Import "detectors/RMDetector.rgr"
Import "detectors/ZoneDetector.rgr"
Import "detectors/RomanZoneDetector.rgr"
Import "detectors/RecoveryTimeDetector.rgr"
Import "detectors/TimeValueDetector.rgr"
Import "detectors/RecoveryDetector.rgr"
Import "detectors/LeftRightDetector.rgr"
Import "detectors/FeelingDetector.rgr"
Import "detectors/EffortDetector.rgr"
Import "detectors/BodyMetricDetector.rgr"
Import "detectors/CircuitDetector.rgr"
Import "detectors/PhaseDetector.rgr"
Import "detectors/ContextEntryDetector.rgr"
Import "detectors/DecimalNumberDetector.rgr"
Import "detectors/PositiveIntegerDetector.rgr"
Import "detectors/KeywordDetector.rgr"
Import "detectors/RepeatBlockDetector.rgr"
Import "detectors/AMTimeValueDetector.rgr"
Import "detectors/DetailsDataDetector.rgr"
Import "detectors/HeadingDataDetector.rgr"

class NGSharedDetectorFactory@(singleton) {
    def sportExerciseChildDetectors:[TokenDetector]

    fn createSportExerciseChildDetectors:[TokenDetector] () {
        if ((array_length sportExerciseChildDetectors) > 0) {
            return sportExerciseChildDetectors
        }

        def ds:[TokenDetector]
        push ds (SpaceDetector.create())
        push ds (SemicolonSeparatorDetector.create())
        push ds (NewlineDetector.create())
        push ds (DateTimeDetector.create())
        push ds (SpeedDetector.create())
        push ds (KCALDetector.create())
        push ds (BPMDetector.create())
        push ds (DistanceRangeBlockDetector.create())
        push ds (RepeatBlockDetector.create())
        push ds (NumRangeBlockDetector.create())
        push ds (RMDetector.create())
        push ds (ZoneDetector.create())
        push ds (RomanZoneDetector.create())
        push ds (RecoveryTimeDetector.create())
        push ds (TimeValueDetector.create())
        push ds (RecoveryDetector.create())
        push ds (LeftRightDetector.create())
        push ds (FeelingDetector.create())
        push ds (EffortDetector.create())
        push ds (BodyMetricDetector.create())
        push ds (CircuitDetector.create())
        push ds (PhaseDetector.create())
        push ds (ContextEntryDetector.create())
        push ds (DecimalNumberDetector.create())
        push ds (PositiveIntegerDetector.create())
        push ds (KeywordDetector.create("min"))
        push ds (KeywordDetector.create("h"))
        push ds (AMTimeValueDetector.create())
        push ds (DetailsDataDetector.create())
        push ds (HeadingDataDetector.create())
        sportExerciseChildDetectors = ds
        return sportExerciseChildDetectors
    }
}
