Import "TokenDetector.rgr"
Import "PositiveIntegerValue.rgr"
Import "SliceParsedValue.rgr"

class PositiveIntegerDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "positive-integer"
    }

    sfn create:PositiveIntegerDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new PositiveIntegerDetector(s))
    }

    fn isDigit:boolean (ch:int) {
        if (ch < 48) {
            return false
        }
        if (ch > 57) {
            return false
        }
        return true
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        if ((slice.length()) == 0) {
            return (this.noMatch())
        }

        def i@(mutable):int 0
        def hasNonZero@(mutable):boolean false

        while (i < (slice.length())) {
            def ch (slice.charCodeAt(i))
            if (this.isDigit(ch)) {
                if (ch != 48) {
                    hasNonZero = true
                }
                i = i + 1
            } {
                break
            }
        }

        if (i == 0) {
            return (this.noMatch())
        }

        if (hasNonZero) {
        } {
            return (this.noMatch())
        }

        def out (slice.read(i))
        out.tag = detectedTag
        def v (new PositiveIntegerValue)
        v.value = (out.parseInteger(0 (i - 1)))
        def payload (SliceParsedValue.fromPositiveInteger(v))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)
        return out
    }
}
