Import "detectors/TokenDetector.rgr"
Import "Parser.rgr"
Import "detectors/NumRangeBlockDetector.rgr"
Import "detectors/KeywordDetector.rgr"
Import "detectors/SpaceDetector.rgr"
Import "values/PercentageRangeValue.rgr"
Import "values/SliceParsedValue.rgr"

class PercentageRangeDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "percentage-range"
    }

    sfn create:PercentageRangeDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new PercentageRangeDetector(s))
    }

    fn isDigit:boolean (ch:int) {
        return ((ch >= 48) && (ch <= 57))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 4) {
            return (this.noMatch())
        }

        def i@(mutable):int 0
        while (i < len) {
            def chL (slice.charCodeAt(i))
            if (this.isDigit(chL)) {
                i = i + 1
            } {
                break
            }
        }
        if ((i > 0) && (i < len) && ((slice.charCodeAt(i)) == 37)) {
            if (((i + 1) < len) && ((slice.charCodeAt(i + 1)) == 45)) {
                def j@(mutable):int (i + 2)
                while (j < len) {
                    def chR (slice.charCodeAt(j))
                    if (this.isDigit(chR)) {
                        j = j + 1
                    } {
                        break
                    }
                }
                if ((j > (i + 2)) && (j < len) && ((slice.charCodeAt(j)) == 37)) {
                    def leftDigits (slice.read(i))
                    def rightDigits (slice.peek(i + 2).read(j - (i + 2)))
                    if (!(leftDigits.hasInteger(0 ((leftDigits.length()) - 1)))) {
                        return (this.noMatch())
                    }
                    if (!(rightDigits.hasInteger(0 ((rightDigits.length()) - 1)))) {
                        return (this.noMatch())
                    }
                    def lval (leftDigits.parseInteger(0 ((leftDigits.length()) - 1)))
                    def rval (rightDigits.parseInteger(0 ((rightDigits.length()) - 1)))
                    if ((lval > 0) && (rval > 0)) {
                        def out2 (slice.read(j + 1))
                        out2.tag = detectedTag
                        def pv2 (new PercentageRangeValue)
                        pv2.minValue = lval
                        pv2.maxValue = rval
                        def payload2 (SliceParsedValue.fromPercentageRange(pv2))
                        out2.setSliceValue(payload2)
                        slice.setSliceValue(payload2)
                        return out2
                    }
                }
            }
        }

        def detectors:[TokenDetector]
        push detectors (SpaceDetector.create())
        push detectors (NumRangeBlockDetector.create())
        push detectors (KeywordDetector.create("%"))

        def p (new Parser((slice.toString()) detectors))
        p.start()
        if ((p.getCount()) != 2) {
            return (this.noMatch())
        }

        def parts (p.getResults())
        def first (itemAt parts 0)
        def second (itemAt parts 1)
        if (!(first.tag == "num-range")) {
            return (this.noMatch())
        }
        if (!(second.tag == "keyword")) {
            return (this.noMatch())
        }
        if (!(second.strEquals("%"))) {
            return (this.noMatch())
        }

        def outLen ((first.length()) + (second.length()))
        def out (slice.read(outLen))
        out.tag = detectedTag
        out.addChild(first)
        out.addChild(second)

        def nrv (first.getAsNumRangeValue())
        def pv (new PercentageRangeValue)
        pv.minValue = nrv.minValue
        pv.maxValue = nrv.maxValue
        def payload (SliceParsedValue.fromPercentageRange(pv))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)
        return out
    }
}
