Import "detectors/TokenDetector.rgr"

class PhaseDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "phase"
    }

    sfn create:PhaseDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new PhaseDetector(s))
    }

    fn findLineEnd:int (slice:TokenSlice from:int) {
        return (slice.findLineEnd(from))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        if (slice.hasToken("Phase")) {
        } {
            return (this.noMatch())
        }

        def lineEnd (this.findLineEnd(slice 0))
        if (lineEnd <= 5) {
            return (this.noMatch())
        }

        def keyEnd@(mutable):int 0
        while (keyEnd < lineEnd) {
            def ch (slice.charCodeAt(keyEnd))
            if (slice.isWhitespace(ch)) {
                break
            }
            if (ch == 124) {
                break
            }
            keyEnd = keyEnd + 1
        }

        if (keyEnd <= 0) {
            return (this.noMatch())
        }

        def keyText ((slice.read(keyEnd)).toString())
        if ((substring keyText 0 5) == "Phase") {
        } {
            return (this.noMatch())
        }

        def contentStart@(mutable):int keyEnd
        if (contentStart < lineEnd) {
            def chSep (slice.charCodeAt(contentStart))
            if ((chSep == 124) || (slice.isWhitespace(chSep))) {
                contentStart = contentStart + 1
            }
        }
        while (contentStart < lineEnd) {
            def chSpace (slice.charCodeAt(contentStart))
            if (slice.isWhitespace(chSpace)) {
                contentStart = contentStart + 1
            } {
                break
            }
        }

        def out (slice.read(lineEnd))
        out.tag = detectedTag

        def label (slice.read(keyEnd))
        label.tag = "keyword"
        out.addChild(label)

        if (contentStart < lineEnd) {
            def contentSlice (slice.peek(contentStart).read(lineEnd - contentStart))
            def textToken (contentSlice.read(lineEnd - contentStart))
            textToken.tag = "text"
            out.addChild(textToken)
        }

        return out
    }
}