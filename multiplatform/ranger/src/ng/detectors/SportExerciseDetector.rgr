Import "detectors/TokenDetector.rgr"
Import "Parser.rgr"
Import "NGSharedLists.rgr"
Import "NGSharedDetectorFactory.rgr"

class SportExerciseDetector {
    Extends(TokenDetector)

    def sports:[string]

    Constructor (noMatchSlice:TokenSlice sportNames:[string]) {
        cachedNoMatch = noMatchSlice
        sports = sportNames
        detectedTag = "exercise"
    }

    sfn create:SportExerciseDetector () {
        def shared (new NGSharedLists())
        def sportNames (shared.defaultSportNames())
        def s (TokenDetector.createNoMatchSlice())
        return (new SportExerciseDetector(s sportNames))
    }

    sfn createWithSports:SportExerciseDetector (sportNames:[string]) {
        def s (TokenDetector.createNoMatchSlice())
        return (new SportExerciseDetector(s sportNames))
    }

    fn createChildDetectors:[TokenDetector] () {
        def shared (new NGSharedDetectorFactory())
        return (shared.createSportExerciseChildDetectors())
    }

    fn isWhitespace:boolean (ch:int) {
        if (ch == 32) {
            return true
        }
        if (ch == 9) {
            return true
        }
        return false
    }

    fn isSeparator:boolean (ch:int) {
        if (this.isWhitespace(ch)) {
            return true
        }
        ; ';'
        if (ch == 59) {
            return true
        }
        return false
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 6) {
            return (this.noMatch())
        }

        def name@(mutable):string ""
        def nameLen@(mutable):int 0
        def matched@(mutable):boolean false

        for sports sportName:string i {
            def sportLen (strlen sportName)
            if (len <= sportLen) {
                continue
            }

            def head (slice.read(sportLen))
            if (!(head.strEquals(sportName))) {
                continue
            }

            def chAfterName (slice.charCodeAt(sportLen))
            if (this.isSeparator(chAfterName)) {
                name = sportName
                nameLen = sportLen
                matched = true
                break
            }
        }

        if (matched == false) {
             return (this.noMatch())
         }

        def restStart@(mutable):int nameLen
        while (restStart < len) {
            def chSpace (slice.charCodeAt(restStart))
            if (this.isSeparator(chSpace)) {
                restStart = restStart + 1
            } {
                break
            }
        }

        if (restStart >= len) {
            return (this.noMatch())
        }

        def lineEnd@(mutable):int restStart
        while (lineEnd < len) {
            def ch (slice.charCodeAt(lineEnd))
            if ((ch == 10) || (ch == 13)) {
                break
            }
            lineEnd = lineEnd + 1
        }

        if (lineEnd <= restStart) {
            return (this.noMatch())
        }

        def restSlice (slice.peek(restStart).read(lineEnd - restStart))
        def p (new Parser((restSlice.toString()) (this.createChildDetectors())))
        p.start()

        if ((p.getCount()) <= 0) {
            return (this.noMatch())
        }

        def nameToken (slice.read(nameLen))
        nameToken.tag = "exercise-name"

        def out (slice.read(lineEnd))
        out.tag = detectedTag
        out.addChild(nameToken)

        def children (p.getResults())
        for children ch:TokenSlice i {
            out.addChild(ch)
        }

        return out
    }
}
