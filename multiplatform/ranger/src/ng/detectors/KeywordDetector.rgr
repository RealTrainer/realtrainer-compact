Import "detectors/TokenDetector.rgr"

class KeywordDetector {
    Extends(TokenDetector)

    def keyword:string ""

    Constructor (token:string noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        keyword = token
        detectedTag = "keyword"
    }

    sfn create:KeywordDetector (token:string) {
        def s (TokenDetector.createNoMatchSlice())
        return (new KeywordDetector(token s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def kLen (strlen keyword)
        if (kLen == 0) {
            return (this.noMatch())
        }
        def size (slice.length())
        if (size < kLen) {
            return (this.noMatch())
        }

        def head (slice.read(kLen).toString())
        if (head == keyword) {
            def matched (slice.read(kLen))
            matched.tag = detectedTag
            return matched
        }
        return (this.noMatch())
    }
}
