Import "detectors/TokenDetector.rgr"
Import "NGSharedLists.rgr"

class RomanZoneDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "zone-roman"
    }

    sfn create:RomanZoneDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new RomanZoneDetector(s))
    }

    fn romanPrefixLen:int (slice:TokenSlice) {
        def shared (new NGSharedLists())
        def candidates (shared.defaultRomanZonePrefixTokens())

        def i@(mutable):int 0
        def cnt (array_length candidates)
        while (i < cnt) {
            def token (itemAt candidates i)
            if (slice.hasToken(token)) {
                return (strlen token)
            }
            i = i + 1
        }

        return 0
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def tokenLen (this.romanPrefixLen(slice))
        if (tokenLen == 0) {
            return (this.noMatch())
        }

        def len (slice.length())
        if (len > tokenLen) {
            if (slice.isAlphaNumAt(tokenLen)) {
                return (this.noMatch())
            }
        }

        def out (slice.read(tokenLen))
        out.tag = detectedTag
        return out
    }
}
