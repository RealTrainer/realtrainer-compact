Import "detectors/TokenDetector.rgr"
Import "values/NumRangeValue.rgr"
Import "values/SliceParsedValue.rgr"

class NumRangeBlockDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "num-range"
    }

    sfn create:NumRangeBlockDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new NumRangeBlockDetector(s))
    }

    fn isWhitespace:boolean (ch:int) {
        if (ch == 32) {
            return true
        }
        if (ch == 9) {
            return true
        }
        return false
    }

    fn isDigit:boolean (ch:int) {
        return ((ch >= 48) && (ch <= 57))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 3) {
            return (this.noMatch())
        }

        def i@(mutable):int 0
        while (i < len) {
            def chSkipLeft (slice.charCodeAt(i))
            if (this.isWhitespace(chSkipLeft)) {
                i = i + 1
            } {
                break
            }
        }

        def leftStart i
        while (i < len) {
            def chLeft (slice.charCodeAt(i))
            if (this.isDigit(chLeft)) {
                i = i + 1
            } {
                break
            }
        }
        def leftEnd i
        if (leftEnd <= leftStart) {
            return (this.noMatch())
        }

        while (i < len) {
            def chBeforeDash (slice.charCodeAt(i))
            if (this.isWhitespace(chBeforeDash)) {
                i = i + 1
            } {
                break
            }
        }

        if ((i >= len) || ((slice.charCodeAt(i)) != 45)) {
            return (this.noMatch())
        }
        i = i + 1

        while (i < len) {
            def chAfterDash (slice.charCodeAt(i))
            if (this.isWhitespace(chAfterDash)) {
                i = i + 1
            } {
                break
            }
        }

        def rightStart i
        while (i < len) {
            def chRight (slice.charCodeAt(i))
            if (this.isDigit(chRight)) {
                i = i + 1
            } {
                break
            }
        }
        def rightEnd i
        if (rightEnd <= rightStart) {
            return (this.noMatch())
        }

        def left (slice.peek(leftStart).read(leftEnd - leftStart))
        def right (slice.peek(rightStart).read(rightEnd - rightStart))
        if (!(left.hasInteger(0 ((left.length()) - 1)))) {
            return (this.noMatch())
        }
        if (!(right.hasInteger(0 ((right.length()) - 1)))) {
            return (this.noMatch())
        }

        def lval (left.parseInteger(0 ((left.length()) - 1)))
        def rval (right.parseInteger(0 ((right.length()) - 1)))
        if (lval <= 0) {
            return (this.noMatch())
        }
        if (rval <= 0) {
            return (this.noMatch())
        }

        def out (slice.read(rightEnd))
        out.tag = detectedTag
        def nv (new NumRangeValue)
        nv.minValue = lval
        nv.maxValue = rval
        def payload (SliceParsedValue.fromNumRange(nv))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)
        return out
    }
}
