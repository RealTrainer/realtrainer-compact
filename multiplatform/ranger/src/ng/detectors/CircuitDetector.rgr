Import "detectors/TokenDetector.rgr"
Import "values/CircuitValue.rgr"
Import "values/SliceParsedValue.rgr"

class CircuitDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "circuit"
    }

    sfn create:CircuitDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new CircuitDetector(s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def prefix:string "Circuit "
        if (slice.hasToken(prefix)) {
        } {
            return (this.noMatch())
        }

        def len (slice.length())
        def roundsStart (strlen prefix)
        def roundsEnd@(mutable):int roundsStart
        while (roundsEnd < len) {
            def ch (slice.charCodeAt(roundsEnd))
            if ((ch >= 48) && (ch <= 57)) {
                roundsEnd = roundsEnd + 1
            } {
                break
            }
        }

        if (roundsEnd <= roundsStart) {
            return (this.noMatch())
        }

        def roundsSlice (slice.peek(roundsStart).read(roundsEnd - roundsStart))
        if (roundsSlice.hasInteger(0 ((roundsSlice.length()) - 1))) {
        } {
            return (this.noMatch())
        }

        def lineEnd@(mutable):int roundsEnd
        while (lineEnd < len) {
            def ch2 (slice.charCodeAt(lineEnd))
            if ((ch2 == 10) || (ch2 == 13)) {
                break
            }
            lineEnd = lineEnd + 1
        }

        def out (slice.read(lineEnd))
        out.tag = detectedTag

        def circuitToken (slice.read(7))
        circuitToken.tag = "keyword"
        out.addChild(circuitToken)
        def roundsToken (slice.peek(roundsStart).read(roundsEnd - roundsStart))
        roundsToken.tag = "positive-integer"
        out.addChild(roundsToken)

        def cv (new CircuitValue)
        cv.rounds = (roundsSlice.parseInteger(0 ((roundsSlice.length()) - 1)))

        if ((roundsEnd < lineEnd) && ((slice.charCodeAt(roundsEnd)) == 47)) {
            def i@(mutable):int (roundsEnd + 1)
            while (i < lineEnd) {
                def ch3 (slice.charCodeAt(i))
                if ((ch3 >= 48) && (ch3 <= 57)) {
                    i = i + 1
                } {
                    break
                }
            }

            if (i > (roundsEnd + 1)) {
                def j@(mutable):int i
                while (j < lineEnd) {
                    def ch4 (slice.charCodeAt(j))
                    if ((ch4 >= 65) && (ch4 <= 90)) {
                        j = j + 1
                        continue
                    }
                    if ((ch4 >= 97) && (ch4 <= 122)) {
                        j = j + 1
                        continue
                    }
                    break
                }

                if (j > i) {
                    def restToken (slice.peek(roundsEnd).read(j - roundsEnd))
                    restToken.tag = "recovery-time"
                    out.addChild(restToken)

                    def vSlice (slice.peek((roundsEnd + 1)).read(i - roundsEnd - 1))
                    cv.restValue = (vSlice.parseInteger(0 ((vSlice.length()) - 1)))
                    def unitRaw (slice.peek(i).read(j - i).toString())
                    if ((unitRaw == "min") || (unitRaw == "m")) {
                        cv.restUnit = "min"
                    }
                    if ((unitRaw == "sec") || (unitRaw == "s")) {
                        cv.restUnit = "sec"
                    }
                }
            }
        }

        def parsed (SliceParsedValue.fromCircuit(cv))
        out.setSliceValue(parsed)
        slice.setSliceValue(parsed)
        return out
    }
}