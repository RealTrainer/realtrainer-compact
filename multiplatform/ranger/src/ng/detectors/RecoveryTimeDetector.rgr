Import "detectors/TokenDetector.rgr"
Import "values/RecoveryTimeValue.rgr"
Import "values/PositiveIntegerValue.rgr"
Import "values/SliceParsedValue.rgr"

class RecoveryTimeDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "recovery-time"
    }

    sfn create:RecoveryTimeDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new RecoveryTimeDetector(s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 3) {
            return (this.noMatch())
        }
        if ((slice.charCodeAt(0)) != 47) {
            return (this.noMatch())
        }

        def i@(mutable):int 1
        def hasNonZero@(mutable):boolean false
        while (i < len) {
            if (slice.isDigitAt(i)) {
                if ((slice.digitAt(i)) != 0) {
                    hasNonZero = true
                }
                i = i + 1
            } {
                break
            }
        }

        if (i == 1) {
            return (this.noMatch())
        }
        if (hasNonZero) {
        } {
            return (this.noMatch())
        }
        if (i >= len) {
            return (this.noMatch())
        }

        def unit (slice.charCodeAt(i))
        if ((unit == 115) || (unit == 109)) {
        } {
            return (this.noMatch())
        }

        def out (slice.read(i + 1))
        out.tag = detectedTag

        def slashToken (slice.read(1))
        slashToken.tag = "keyword"
        out.addChild(slashToken)

        def valueToken (slice.peek(1).read(i - 1))
        valueToken.tag = "positive-integer"
        def piv (new PositiveIntegerValue)
        piv.value = (valueToken.parseInteger(0 ((valueToken.length()) - 1)))
            def parsedValue (SliceParsedValue.fromPositiveInteger(piv))
            valueToken.setSliceValue(parsedValue)
        out.addChild(valueToken)

        def unitToken (slice.peek(i).read(1))
        unitToken.tag = "keyword"
        out.addChild(unitToken)

        def rv (new RecoveryTimeValue)
        rv.value = (slice.read(i).peek(1).parseInteger(0 (i - 2)))
        if (unit == 115) {
            rv.unit = "s"
        } {
            rv.unit = "m"
        }
        def payload (SliceParsedValue.fromRecoveryTime(rv))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)
        return out
    }
}
