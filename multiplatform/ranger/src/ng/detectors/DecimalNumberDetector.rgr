Import "detectors/TokenDetector.rgr"

class DecimalNumberDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "decimal-number"
    }

    sfn create:DecimalNumberDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new DecimalNumberDetector(s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len == 0) {
            return (this.noMatch())
        }

        def i@(mutable):int 0
        while (i < len) {
            if (slice.isDigitAt(i)) {
                i = i + 1
            } {
                break
            }
        }
        if (i == 0) {
            return (this.noMatch())
        }
        if (i >= len) {
            return (this.noMatch())
        }
        if ((slice.charCodeAt(i)) != 46) {
            return (this.noMatch())
        }

        def j@(mutable):int (i + 1)
        while (j < len) {
            if (slice.isDigitAt(j)) {
                j = j + 1
            } {
                break
            }
        }

        if (j == (i + 1)) {
            return (this.noMatch())
        }

        def out (slice.read(j))
        out.tag = detectedTag
        return out
    }
}