Import "detectors/TokenDetector.rgr"
Import "detectors/PositiveIntegerDetector.rgr"
Import "Parser.rgr"
Import "values/FeelingValue.rgr"
Import "values/SliceParsedValue.rgr"
Import "NGSubParserDetectors.rgr"

class FeelingDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "feeling"
    }

    sfn create:FeelingDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new FeelingDetector(s))
    }

    fn parseNumericScore:int (slice:TokenSlice) {
        def subReg (new NGSubParserDetectors())
        def detectors (subReg.getPositiveIntegerOnlyChildDetectors())
        def p (Parser.fromSlice(slice detectors))
        p.start()
        if ((p.getCount()) != 1) {
            return -1
        }
        def scoreToken (itemAt (p.getResults()) 0)
        if (scoreToken.tag == "positive-integer") {
            return (scoreToken.parseInteger(0 ((scoreToken.length()) - 1)))
        }
        return -1
    }

    fn parseSlashTenScore:int (slice:TokenSlice) {
        if (slice.hasToken("?/10")) {
            return 0
        }

        def len (slice.length())
        def i@(mutable):int 1
        while ((i + 2) < len) {
            if ((slice.charCodeAt(i)) == 47) {
                if (((slice.charCodeAt(i + 1)) == 49) && ((slice.charCodeAt(i + 2)) == 48)) {
                    def start@(mutable):int i
                    while (start > 0) {
                        if (slice.isDigitAt(start - 1)) {
                            start = start - 1
                        } {
                            break
                        }
                    }

                    if (start < i) {
                        def numSlice (slice.peek(start).read(i - start))
                        if (numSlice.hasInteger(0 ((numSlice.length()) - 1))) {
                            return (numSlice.parseInteger(0 ((numSlice.length()) - 1)))
                        }
                    }
                }
            }
            i = i + 1
        }

        return -1
    }

    fn parseKind:string (slice:TokenSlice) {
        if (slice.hasToken("Feeling ")) {
            return "feeling"
        }
        if (slice.hasToken("Feelings ")) {
            return "feeling"
        }
        if (slice.hasToken("Pain ")) {
            return "pain"
        }
        return ""
    }

    fn prefixLength:int (slice:TokenSlice kind:string) {
        if (kind == "pain") {
            return 5
        }
        if (slice.hasToken("Feelings ")) {
            return 9
        }
        return 8
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def kind (this.parseKind(slice))
        if ((strlen kind) == 0) {
            return (this.noMatch())
        }

        def keyLen (this.prefixLength(slice kind))
        def len (slice.length())
        if (keyLen >= len) {
            return (this.noMatch())
        }

        def lineEnd (slice.findLineEnd(keyLen))

        def rawSlice (slice.peek(keyLen).read(lineEnd - keyLen))

        def trimStart@(mutable):int 0
        def rawLen (rawSlice.length())
        while (trimStart < rawLen) {
            def chStart (rawSlice.charCodeAt(trimStart))
            if (rawSlice.isWhitespace(chStart)) {
                trimStart = trimStart + 1
            } {
                break
            }
        }

        def trimEnd@(mutable):int rawLen
        while (trimEnd > trimStart) {
            def chEnd (rawSlice.charCodeAt(trimEnd - 1))
            if (rawSlice.isWhitespace(chEnd)) {
                trimEnd = trimEnd - 1
            } {
                break
            }
        }

        def score@(mutable):int -1
        if (trimEnd > trimStart) {
            def valueSlice (rawSlice.peek(trimStart).read(trimEnd - trimStart))

            score = (this.parseNumericScore(valueSlice))
            if (score < 0) {
                if ((kind == "feeling") && (valueSlice.hasToken("RPE:"))) {
                    if ((valueSlice.length()) > 4) {
                        def rpeSlice (valueSlice.peek(4).read((valueSlice.length()) - 4))
                        score = (this.parseNumericScore(rpeSlice))
                    }
                }
            }

            if (score < 0) {
                score = (this.parseSlashTenScore(valueSlice))
            }

            if (score < 0) {
                if ((valueSlice.charCodeAt(0)) == 124) {
                    score = 0
                }
            }

            if (score < 0) {
                if ((kind == "pain") && (valueSlice.hasToken("-|"))) {
                    score = 0
                }
            }
        } {
            score = 0
        }

        if (score < 0) {
            return (this.noMatch())
        }

        def out (slice.read(lineEnd))
        out.tag = detectedTag

        def labelLen@(mutable):int (keyLen - 1)
        if (labelLen < 1) {
            labelLen = 1
        }
        def label (slice.read(labelLen))
        label.tag = "keyword"
        out.addChild(label)

        def scoreToken (TokenSlice.fromText(("" + score)))
        scoreToken.tag = "positive-integer"
        out.addChild(scoreToken)

        def fv (new FeelingValue)
        fv.kind = kind
        fv.score = score
        def parsed (SliceParsedValue.fromFeeling(fv))
        out.setSliceValue(parsed)
        slice.setSliceValue(parsed)
        return out
    }
}