Import "detectors/TokenDetector.rgr"

class DistanceRangeBlockDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "distance-range"
    }

    sfn create:DistanceRangeBlockDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new DistanceRangeBlockDetector(s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 5) {
            return (this.noMatch())
        }

        def lLen (slice.findNumberEnd(0))
        if (lLen <= 0) {
            return (this.noMatch())
        }
        if (!(slice.hasInteger(0 (lLen - 1)))) {
            return (this.noMatch())
        }
        if (lLen >= len) {
            return (this.noMatch())
        }

        def sep (slice.charCodeAt(lLen))

        ; variant A: 100-200m
        if (sep == 45) {
            def rightAStart (lLen + 1)
            if (rightAStart >= len) {
                return (this.noMatch())
            }

            def rightA (slice.peek(rightAStart))
            def rLenA (rightA.findNumberEnd(0))
            if (rLenA <= 0) {
                return (this.noMatch())
            }
            if (!(rightA.hasInteger(0 (rLenA - 1)))) {
                return (this.noMatch())
            }
            if ((rLenA + 1) > (rightA.length())) {
                return (this.noMatch())
            }
            if ((rightA.charCodeAt(rLenA)) != 109) {
                return (this.noMatch())
            }

            def lvalA (slice.parseInteger(0 (lLen - 1)))
            def rvalA (rightA.parseInteger(0 (rLenA - 1)))
            if ((lvalA <= 0) || (rvalA <= 0)) {
                return (this.noMatch())
            }

            def outA (slice.read(rightAStart + rLenA + 1))
            outA.tag = detectedTag
            return outA
        }

        if (sep != 109) {
            return (this.noMatch())
        }

        ; variant B: 100m-200m
        def lLenB lLen
        if ((lLenB + 2) > len) {
            return (this.noMatch())
        }
        if ((slice.charCodeAt(lLenB + 1)) != 45) {
            return (this.noMatch())
        }

        def rightBStart (lLenB + 2)
        if (rightBStart >= len) {
            return (this.noMatch())
        }
        def rightB (slice.peek(rightBStart))
        def rLenB (rightB.findNumberEnd(0))
        if (rLenB <= 0) {
            return (this.noMatch())
        }
        if (rightB.hasInteger(0 (rLenB - 1))) {
        } {
            return (this.noMatch())
        }
        if ((rLenB + 1) > (rightB.length())) {
            return (this.noMatch())
        }
        if ((rightB.charCodeAt(rLenB)) != 109) {
            return (this.noMatch())
        }

        def lvalB (slice.parseInteger(0 (lLenB - 1)))
        def rvalB (rightB.parseInteger(0 (rLenB - 1)))
        if ((lvalB <= 0) || (rvalB <= 0)) {
            return (this.noMatch())
        }

        def outB (slice.read(rightBStart + rLenB + 1))
        outB.tag = detectedTag
        return outB
    }
}
