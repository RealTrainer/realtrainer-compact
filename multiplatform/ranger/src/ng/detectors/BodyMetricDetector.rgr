Import "detectors/TokenDetector.rgr"
Import "values/BodyMetricValue.rgr"
Import "values/SliceParsedValue.rgr"

class BodyMetricDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "body-metric"
    }

    sfn create:BodyMetricDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new BodyMetricDetector(s))
    }

    fn findLineEnd:int (slice:TokenSlice from:int) {
        return (slice.findLineEnd(from))
    }

    fn createMetricSlice:TokenSlice (slice:TokenSlice offset:int lineEnd:int) {
        if (offset >= lineEnd) {
            return (slice.read(0))
        }
        return (slice.peek(offset).read(lineEnd - offset))
    }

    fn parseDoublePrefix:double (metricSlice:TokenSlice) {
        def len (metricSlice.length())
        def i@(mutable):int 0
        while (i < len) {
            def ch (metricSlice.charCodeAt(i))
            if ((ch >= 48) && (ch <= 57)) {
                i = i + 1
                continue
            }
            if (ch == 46) {
                i = i + 1
                continue
            }
            break
        }
        if (i == 0) {
            return -1.0
        }
        if (metricSlice.hasDouble(0 (i - 1))) {
            return (metricSlice.parseDouble(0 (i - 1)))
        }
        return -1.0
    }

    fn parseIntegerPrefix:int (metricSlice:TokenSlice) {
        def i (metricSlice.findNumberEnd(0))
        if (i == 0) {
            return -1
        }
        if (metricSlice.hasInteger(0 (i - 1))) {
            return (metricSlice.parseInteger(0 (i - 1)))
        }
        return -1
    }

    fn setCommon:void (out:TokenSlice source:TokenSlice value:BodyMetricValue) {
        def parsed (SliceParsedValue.fromBodyMetric(value))
        out.setSliceValue(parsed)
        source.setSliceValue(parsed)
    }

    fn detectSimpleDoubleMetric:TokenSlice (
        slice:TokenSlice
        prefix:string
        labelLen:int
        metricName:string
        unit:string
        allowZero:boolean
    ) {
        if (slice.hasToken(prefix)) {
        } {
            return (this.noMatch())
        }

        def prefixLen (strlen prefix)
        def lineEnd (this.findLineEnd(slice prefixLen))
        def out (slice.read(lineEnd))
        out.tag = detectedTag

        def label (slice.read(labelLen))
        label.tag = "keyword"
        out.addChild(label)

        def metric (this.createMetricSlice(slice prefixLen lineEnd))
        def value (this.parseDoublePrefix(metric))
        if (allowZero) {
            if (value < 0.0) {
                return (this.noMatch())
            }
        } {
            if (value <= 0.0) {
                return (this.noMatch())
            }
        }

        def mv (new BodyMetricValue)
        mv.metric = metricName
        mv.primaryValue = value
        mv.unit = unit
        this.setCommon(out slice mv)
        return out
    }

    fn detectWeight:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "Weight " 6 "weight" "kg" false))
    }

    fn detectBodyFat:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "BodyFat " 7 "body-fat" "%" true))
    }

    fn detectSleep:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "Sleep " 5 "sleep" "h" false))
    }

    fn detectRestingHr:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "Health resting_hr " 17 "resting-hr" "bpm" false))
    }

    fn detectBp:TokenSlice (slice:TokenSlice) {
        def prefix:string "Vitals bp "
        if (slice.hasToken(prefix)) {
        } {
            return (this.noMatch())
        }

        def lineEnd (this.findLineEnd(slice (strlen prefix)))
        def metric (this.createMetricSlice(slice (strlen prefix) lineEnd))
        def slashPos (metric.findTokenPos("/"))
        if ((slashPos < 1) || (slashPos >= ((metric.length()) - 1))) {
            return (this.noMatch())
        }

        def left (metric.read(slashPos))
        def right (metric.peek(slashPos + 1).read((metric.length()) - slashPos - 1))
        if (left.hasInteger(0 ((left.length()) - 1))) {
        } {
            return (this.noMatch())
        }
        if (right.hasInteger(0 ((right.length()) - 1))) {
        } {
            return (this.noMatch())
        }

        def out (slice.read(lineEnd))
        out.tag = detectedTag
        def label (slice.read(9))
        label.tag = "keyword"
        out.addChild(label)

        def mv (new BodyMetricValue)
        mv.metric = "blood-pressure"
        mv.primaryValue = (left.parseDouble(0 ((left.length()) - 1)))
        mv.secondaryValue = (right.parseInteger(0 ((right.length()) - 1)))
        mv.unit = "mmhg"
        this.setCommon(out slice mv)
        return out
    }

    fn detectVitalsWeight:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "Vitals weight:" 13 "weight" "kg" false))
    }

    fn detectVitalsSleep:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "Vitals sleep:" 12 "sleep" "h" false))
    }

    fn detectVitalsRhr:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "Vitals rhr:" 10 "resting-hr" "bpm" false))
    }

    fn detectWaist:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "Waist " 5 "waist" "cm" false))
    }

    fn detectHip:TokenSlice (slice:TokenSlice) {
        return (this.detectSimpleDoubleMetric(slice "Hip " 3 "hip" "cm" false))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def w (this.detectWeight(slice))
        if (w.isEmpty()) {
        } {
            return w
        }

        def bf (this.detectBodyFat(slice))
        if (bf.isEmpty()) {
        } {
            return bf
        }

        def sl (this.detectSleep(slice))
        if (sl.isEmpty()) {
        } {
            return sl
        }

        def hr (this.detectRestingHr(slice))
        if (hr.isEmpty()) {
        } {
            return hr
        }

        def vw (this.detectVitalsWeight(slice))
        if (vw.isEmpty()) {
        } {
            return vw
        }

        def vs (this.detectVitalsSleep(slice))
        if (vs.isEmpty()) {
        } {
            return vs
        }

        def vr (this.detectVitalsRhr(slice))
        if (vr.isEmpty()) {
        } {
            return vr
        }

        def waist (this.detectWaist(slice))
        if (waist.isEmpty()) {
        } {
            return waist
        }

        def hip (this.detectHip(slice))
        if (hip.isEmpty()) {
        } {
            return hip
        }

        return (this.detectBp(slice))
    }
}