Import "detectors/TokenDetector.rgr"
Import "Parser.rgr"
Import "detectors/PositiveIntegerDetector.rgr"
Import "detectors/KeywordDetector.rgr"
Import "NGSubParserDetectors.rgr"
Import "values/WeightValue.rgr"
Import "values/SliceParsedValue.rgr"

class WeightDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "weight"
    }

    sfn create:WeightDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new WeightDetector(s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 3) {
            return (this.noMatch())
        }

        def subReg (new NGSubParserDetectors())
        def detectors (subReg.getWeightChildDetectors())

        def p (Parser.fromSlice(slice detectors))
        p.start()
        if ((p.getCount()) != 2) {
            return (this.noMatch())
        }

        def parts (p.getResults())
        def first (itemAt parts 0)
        def second (itemAt parts 1)

        def isInt (first.tag == "positive-integer")
        def isDec (first.tag == "decimal-number")
        if ((isInt == false) && (isDec == false)) {
            return (this.noMatch())
        }
        if (!(second.tag == "keyword")) {
            return (this.noMatch())
        }
        if (!(second.strEquals("kg"))) {
            return (this.noMatch())
        }

        def outLen ((first.length()) + (second.length()))
        def out (slice.read(outLen))
        out.tag = detectedTag
        out.addChild(first)
        out.addChild(second)

        def firstLen (first.length())
        def wv (new WeightValue)
        wv.value = (first.parseDouble(0 (firstLen - 1)))
        wv.unit = "kg"
        def payload (SliceParsedValue.fromWeight(wv))
        out.setSliceValue(payload)
        slice.setSliceValue(payload)
        return out
    }
}
