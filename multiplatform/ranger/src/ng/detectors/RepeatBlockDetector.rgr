Import "detectors/TokenDetector.rgr"
Import "Parser.rgr"
Import "NGSubParserDetectors.rgr"
Import "values/RepeatBlockValue.rgr"
Import "values/RepeatPartValue.rgr"
Import "values/SliceParsedValue.rgr"

; RepeatBlockDetector parses any quantity-bearing expression as a sequence
; of "parts" separated by 'x', optionally suffixed with "@bw" load marker.
;
; Examples:
;   "5"           -> rejected (let PositiveIntegerDetector handle)
;   "30s"         -> repeat-block parts=[duration(30s)]
;   "100m"        -> repeat-block parts=[distance(100m)]
;   "60kg"        -> repeat-block parts=[weight(60kg)]
;   "70%"         -> repeat-block parts=[percentage(70)]
;   "60-70%"      -> repeat-block parts=[percentage-range(60..70)]
;   "2-3"         -> rejected (no x, no unit-bearing kind)
;   "5x60kg"      -> repeat-block parts=[posint(5), weight(60kg)]
;   "2-3x15-20"   -> repeat-block parts=[numRange(2..3), numRange(15..20)]
;   "4x3-8x60kg"  -> repeat-block parts=[posint(4), numRange(3..8), weight(60kg)]
;   "2-3x15-20@bw"-> repeat-block parts=[numRange,numRange] loadMode=bw
class RepeatBlockDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "repeat-block"
    }

    sfn create:RepeatBlockDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new RepeatBlockDetector(s))
    }

    fn isAlphaCode:boolean (c:int) {
        if ((c >= 65) && (c <= 90)) {
            return true
        }
        if ((c >= 97) && (c <= 122)) {
            return true
        }
        return false
    }

    ; Build a hierarchical RepeatPartValue from a parsed sub-token.
    ; Returns null if the token tag is not a recognized "value" kind.
    fn buildPart:RepeatPartValue (tok:TokenSlice) {
        def part (new RepeatPartValue)
        def t tok.tag
        if (t == "positive-integer") {
            part.kind = "positive-integer"
            part.positiveInteger = (tok.getAsPositiveIntegerValue())
            return part
        }
        if (t == "num-range") {
            part.kind = "num-range"
            part.numRange = (tok.getAsNumRangeValue())
            return part
        }
        if (t == "distance") {
            part.kind = "distance"
            part.distance = (tok.getAsDistanceValue())
            return part
        }
        if (t == "weight") {
            part.kind = "weight"
            part.weight = (tok.getAsWeightValue())
            return part
        }
        if (t == "duration") {
            part.kind = "duration"
            part.duration = (tok.getAsDurationValue())
            return part
        }
        if (t == "time-value") {
            part.kind = "time-value"
            part.timeValue = (tok.getAsTimeValueValue())
            return part
        }
        if (t == "percentage") {
            part.kind = "percentage"
            part.percentage = (tok.getAsPercentageValue())
            return part
        }
        if (t == "percentage-range") {
            part.kind = "percentage-range"
            part.percentageRange = (tok.getAsPercentageRangeValue())
            return part
        }
        ; Unrecognized value tag.
        part.kind = ""
        return part
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 2) {
            return (this.noMatch())
        }

        def subReg (new NGSubParserDetectors())
        def detectors (subReg.getRepeatBlockChildDetectors())
        def p (Parser.fromSlice(slice detectors))
        p.start()
        def n (p.getCount())
        if (n == 0) {
            return (this.noMatch())
        }
        def results (p.getResults())

        def rv (new RepeatBlockValue)
        def consumed@(mutable):int 0
        def hasX@(mutable):boolean false
        def expectPart@(mutable):boolean true
        def stop@(mutable):boolean false
        def lastPartLen@(mutable):int 0
        def lastWasNonInteger@(mutable):boolean false

        def i@(mutable):int 0
        while ((i < n) && (stop == false)) {
            def tok (itemAt results i)
            def ttag tok.tag
            def ttext (tok.toString())
            def tlen (tok.length())

            if expectPart {
                def part (this.buildPart(tok))
                if ((strlen part.kind) > 0) {
                    push rv.parts part
                    consumed = consumed + tlen
                    expectPart = false
                    lastPartLen = tlen
                    if (part.kind == "positive-integer") {
                        lastWasNonInteger = false
                    } {
                        lastWasNonInteger = true
                    }
                } {
                    stop = true
                }
            } {
                if ((ttag == "keyword") && (ttext == "x")) {
                    hasX = true
                    consumed = consumed + tlen
                    expectPart = true
                } {
                    if ((ttag == "keyword") && (ttext == "@bw")) {
                        rv.loadMode = "bw"
                        consumed = consumed + tlen
                        stop = true
                    } {
                        stop = true
                    }
                }
            }
            i = i + 1
        }

        ; Backoff: if we consumed a trailing positive-integer part and the next
        ; byte in the original slice is alpha (e.g. "kg", "m", "s") that no
        ; sub-detector matched, drop that trailing part so a more specific
        ; outer detector can pick it up. Only applies after an 'x'.
        if ((expectPart == false) && (hasX == true) && (consumed < len)) {
            if (lastWasNonInteger == false) {
                def nc (slice.charCodeAt(consumed))
                if (this.isAlphaCode(nc)) {
                    def last (array_length rv.parts)
                    if (last >= 1) {
                        def newParts:[RepeatPartValue]
                        def j@(mutable):int 0
                        while (j < (last - 1)) {
                            push newParts (itemAt rv.parts j)
                            j = j + 1
                        }
                        rv.parts = newParts
                        consumed = consumed - lastPartLen
                    }
                }
            }
        }

        ; Validation:
        ;   - must have at least one part
        ;   - either has 'x' separator OR the (single) part has a unit-bearing kind
        ;     (i.e. not a bare positive-integer or bare num-range)
        def partCount (array_length rv.parts)
        if (partCount == 0) {
            return (this.noMatch())
        }
        if (hasX == false) {
            if (partCount == 1) {
                def only (itemAt rv.parts 0)
                if (only.kind == "positive-integer") {
                    return (this.noMatch())
                }
                if (only.kind == "num-range") {
                    return (this.noMatch())
                }
            }
        }

        ; Exercise-name guard: if our match is followed by whitespace + alpha
        ; word + ';' on the same line, bail out so SportExerciseDetector can
        ; claim the whole "<num-prefix> <name>; <rest>" line as an exercise.
        ; Example: "4x400m viesti; 130bpm" should be exercise, not repeat-block.
        if (consumed < len) {
            def lineEnd (slice.findLineEnd(0))
            def k@(mutable):int consumed
            while (k < lineEnd) {
                if (slice.isWhitespaceAt(k)) {
                    k = k + 1
                } {
                    break
                }
            }
            if ((k > consumed) && (k < lineEnd)) {
                if (this.isAlphaCode((slice.charCodeAt(k)))) {
                    def m@(mutable):int k
                    def hasSemi@(mutable):boolean false
                    while (m < lineEnd) {
                        if ((slice.charCodeAt(m)) == 59) {
                            hasSemi = true
                            break
                        }
                        m = m + 1
                    }
                    if hasSemi {
                        return (this.noMatch())
                    }
                }
            }
        }

        def out (slice.read(consumed))
        out.tag = detectedTag
        def payload (SliceParsedValue.fromRepeatBlock(rv))
        out.setSliceValue(payload)
        return out
    }
}
