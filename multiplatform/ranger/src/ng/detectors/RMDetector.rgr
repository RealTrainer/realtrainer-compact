Import "detectors/TokenDetector.rgr"
Import "Parser.rgr"
Import "detectors/PositiveIntegerDetector.rgr"
Import "detectors/KeywordDetector.rgr"
Import "NGSubParserDetectors.rgr"

class RMDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "rm"
    }

    sfn create:RMDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new RMDetector(s))
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len < 3) {
            return (this.noMatch())
        }

        def subReg (new NGSubParserDetectors())
        def detectors (subReg.getRmChildDetectors())

        def p (Parser.fromSlice(slice detectors))
        p.start()
        if ((p.getCount()) != 2) {
            return (this.noMatch())
        }

        def parts (p.getResults())
        def first (itemAt parts 0)
        def second (itemAt parts 1)
        if (!(first.tag == "positive-integer")) {
            return (this.noMatch())
        }
        if (!(second.tag == "keyword")) {
            return (this.noMatch())
        }
        if (!(second.strEquals("RM"))) {
            return (this.noMatch())
        }

        def outLen ((first.length()) + (second.length()))
        def out (slice.read(outLen))
        out.tag = detectedTag
        out.addChild(first)
        out.addChild(second)
        return out
    }
}