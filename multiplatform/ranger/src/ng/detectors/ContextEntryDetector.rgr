Import "detectors/TokenDetector.rgr"
Import "NGSharedLists.rgr"
Import "values/ContextEntryValue.rgr"
Import "values/SliceParsedValue.rgr"

class ContextEntryDetector {
    Extends(TokenDetector)

    Constructor (noMatchSlice:TokenSlice) {
        cachedNoMatch = noMatchSlice
        detectedTag = "context-entry"
    }

    sfn create:ContextEntryDetector () {
        def s (TokenDetector.createNoMatchSlice())
        return (new ContextEntryDetector(s))
    }

    fn toTag:string (kind:string) {
        def shared (new NGSharedLists())
        if (shared.isContextEntryKind(kind)) {
            return kind
        }
        return detectedTag
    }

    fn detectKind:string (slice:TokenSlice) {
        def shared (new NGSharedLists())
        def kinds (shared.defaultContextEntryKinds())
        def prefixes (shared.defaultContextEntryPrefixTokens())
        def cnt (array_length kinds)
        def i@(mutable):int 0
        while (i < cnt) {
            if (slice.hasToken((itemAt prefixes i))) {
                return (itemAt kinds i)
            }
            i = i + 1
        }
        return ""
    }

    fn findLineEnd:int (slice:TokenSlice start:int) {
        return (slice.findLineEnd(start))
    }

    fn parseDerivedFields:void (cv:ContextEntryValue valueSlice:TokenSlice) {
        def len (valueSlice.length())
        if (len <= 0) {
            return
        }

        def i@(mutable):int 0
        while (i < len) {
            def chStart (valueSlice.charCodeAt(i))
            if (valueSlice.isWhitespace(chStart)) {
                i = i + 1
            } {
                break
            }
        }

        if (i >= len) {
            return
        }

        def metricStart i
        while (i < len) {
            def chMetric (valueSlice.charCodeAt(i))
            if (valueSlice.isWhitespace(chMetric)) {
                break
            }
            i = i + 1
        }
        def metricEnd i
        if (metricEnd > metricStart) {
            cv.name = (valueSlice.peek(metricStart).read(metricEnd - metricStart).toString())
        }

        while (i < len) {
            def chAfterMetric (valueSlice.charCodeAt(i))
            if (valueSlice.isWhitespace(chAfterMetric)) {
                i = i + 1
            } {
                break
            }
        }

        if (i >= len) {
            return
        }

        def valueStart i
        while (i < len) {
            def chNum (valueSlice.charCodeAt(i))
            ; '|' or ';' ends the numeric part before unit token
            if ((chNum == 124) || (chNum == 59) || (valueSlice.isWhitespace(chNum))) {
                break
            }
            i = i + 1
        }
        def valueEnd i
        if (valueEnd > valueStart) {
            def valueToken (valueSlice.peek(valueStart).read(valueEnd - valueStart))
            cv.value = (valueToken.toString())
            if (valueToken.hasDouble(0 ((valueToken.length()) - 1))) {
                cv.numericValue = (valueToken.parseDouble(0 ((valueToken.length()) - 1)))
                cv.hasNumeric = true
            }
        }

        if (i < len) {
            def sep (valueSlice.charCodeAt(i))
            if ((sep == 124) || (sep == 59)) {
                i = i + 1
                while (i < len) {
                    def chUnitStart (valueSlice.charCodeAt(i))
                    if (valueSlice.isWhitespace(chUnitStart)) {
                        i = i + 1
                    } {
                        break
                    }
                }

                def unitStart i
                while (i < len) {
                    def chUnit (valueSlice.charCodeAt(i))
                    if (valueSlice.isWhitespace(chUnit)) {
                        break
                    }
                    i = i + 1
                }
                def unitEnd i
                if (unitEnd > unitStart) {
                    cv.unit = (valueSlice.peek(unitStart).read(unitEnd - unitStart).toString())
                }

                while (i < len) {
                    def chBeforeToken (valueSlice.charCodeAt(i))
                    if (valueSlice.isWhitespace(chBeforeToken)) {
                        i = i + 1
                    } {
                        break
                    }
                }

                while (i < len) {
                    def tokenStart i
                    while (i < len) {
                        def chToken (valueSlice.charCodeAt(i))
                        if (valueSlice.isWhitespace(chToken)) {
                            break
                        }
                        i = i + 1
                    }
                    def tokenEnd i

                    if (tokenEnd > tokenStart) {
                        def tokenSlice (valueSlice.peek(tokenStart).read(tokenEnd - tokenStart))
                        def tokenLen (tokenSlice.length())
                        def colonAt@(mutable):int -1
                        def j@(mutable):int 0
                        while (j < tokenLen) {
                            if ((tokenSlice.charCodeAt(j)) == 58) {
                                colonAt = j
                                break
                            }
                            j = j + 1
                        }

                        if ((colonAt > 0) && (colonAt < (tokenLen - 1))) {
                            def key ((tokenSlice.peek(0).read(colonAt)).toString())
                            def valSlice (tokenSlice.peek(colonAt + 1).read(tokenLen - (colonAt + 1)))
                            def valLen (valSlice.length())

                            if (key == "basis") {
                                cv.basis = (valSlice.toString())
                            }
                            if (key == "source") {
                                cv.source = (valSlice.toString())
                            }
                            if (key == "confidence") {
                                if (valLen > 0) {
                                    def lastCh (valSlice.charCodeAt(valLen - 1))
                                    if (lastCh == 37) {
                                        if (valLen > 1) {
                                            def numSlice (valSlice.peek(0).read(valLen - 1))
                                            if (numSlice.hasDouble(0 ((numSlice.length()) - 1))) {
                                                cv.confidence = (numSlice.parseDouble(0 ((numSlice.length()) - 1)))
                                                cv.hasConfidence = true
                                            }
                                        }
                                    } {
                                        if (valSlice.hasDouble(0 ((valSlice.length()) - 1))) {
                                            cv.confidence = (valSlice.parseDouble(0 ((valSlice.length()) - 1)))
                                            cv.hasConfidence = true
                                        }
                                    }
                                }
                            }
                            if (key == "goodness") {
                                if (valSlice.hasInteger(0 ((valSlice.length()) - 1))) {
                                    cv.goodness = (valSlice.parseInteger(0 ((valSlice.length()) - 1)))
                                    cv.hasGoodness = true
                                }
                            }
                        }
                    }

                    while (i < len) {
                        def chGap (valueSlice.charCodeAt(i))
                        if (valueSlice.isWhitespace(chGap)) {
                            i = i + 1
                        } {
                            break
                        }
                    }
                }
            }
        }
    }

    fn detect:TokenSlice (slice:TokenSlice) {
        def len (slice.length())
        if (len > 1) {
            def quote (slice.charCodeAt(0))
            if ((quote == 34) || (quote == 39)) {
                def lineEndQuoted (this.findLineEnd(slice 1))
                def contentStart:int 1
                def contentEnd@(mutable):int lineEndQuoted
                if ((lineEndQuoted > 1) && ((slice.charCodeAt(lineEndQuoted - 1)) == quote)) {
                    contentEnd = lineEndQuoted - 1
                }
                if (contentEnd <= contentStart) {
                    return (this.noMatch())
                }

                def outQuoted (slice.read(lineEndQuoted))
                outQuoted.tag = "comment"

                def contentSlice (slice.peek(contentStart).read(contentEnd - contentStart))
                def textToken (contentSlice.read(contentEnd - contentStart))
                textToken.tag = "text"
                outQuoted.addChild(textToken)

                def quotedValue (new ContextEntryValue)
                quotedValue.kind = "comment"
                quotedValue.content = (contentSlice.toString())

                def quotedParsed (SliceParsedValue.fromContextEntry(quotedValue))
                outQuoted.setSliceValue(quotedParsed)
                slice.setSliceValue(quotedParsed)
                return outQuoted
            }
        }

        def kind (this.detectKind(slice))
        def kindLen (strlen kind)
        if (kindLen == 0) {
            return (this.noMatch())
        }

        def keyLen (kindLen + 1)

        if (keyLen >= len) {
            return (this.noMatch())
        }

        def lineEnd (this.findLineEnd(slice keyLen))

        def out (slice.read(lineEnd))
        out.tag = (this.toTag(kind))

        def labelLen (keyLen - 1)
        def label (slice.read(labelLen))
        label.tag = "keyword"
        out.addChild(label)

        if (keyLen < lineEnd) {
            def contentSlice (slice.peek(keyLen).read(lineEnd - keyLen))
            def content (contentSlice.toString())
            if ((strlen content) > 0) {
                def textToken (contentSlice.read((strlen content)))
                textToken.tag = "text"
                out.addChild(textToken)
            }
        }

        def cv (new ContextEntryValue)
        cv.kind = kind
        if (keyLen < lineEnd) {
            cv.content = (slice.peek(keyLen).read(lineEnd - keyLen).toString())
        }

        if (kind == "derived") {
            if (keyLen < lineEnd) {
                def derivedSlice (slice.peek(keyLen).read(lineEnd - keyLen))
                this.parseDerivedFields(cv derivedSlice)
            }
        }

        if (kind == "custom") {
            def customSlice (slice.peek(keyLen).read(lineEnd - keyLen))
            def customLen (customSlice.length())

            def fieldStart@(mutable):int 0
            while (fieldStart < customLen) {
                def chStart (customSlice.charCodeAt(fieldStart))
                if (customSlice.isWhitespace(chStart)) {
                    fieldStart = fieldStart + 1
                } {
                    break
                }
            }

            def fieldEnd@(mutable):int fieldStart
            while (fieldEnd < customLen) {
                def chField (customSlice.charCodeAt(fieldEnd))
                if (customSlice.isWhitespace(chField)) {
                    break
                }
                fieldEnd = fieldEnd + 1
            }

            if (fieldEnd > fieldStart) {
                cv.name = (customSlice.peek(fieldStart).read(fieldEnd - fieldStart).toString())

                def valueStart@(mutable):int fieldEnd
                while (valueStart < customLen) {
                    def chValueStart (customSlice.charCodeAt(valueStart))
                    if (customSlice.isWhitespace(chValueStart)) {
                        valueStart = valueStart + 1
                    } {
                        break
                    }
                }

                if (valueStart < customLen) {
                    def valueSlice (customSlice.peek(valueStart).read(customLen - valueStart))
                    cv.value = (valueSlice.toString())
                    if (valueSlice.hasDouble(0 ((valueSlice.length()) - 1))) {
                        cv.numericValue = (valueSlice.parseDouble(0 ((valueSlice.length()) - 1)))
                        cv.hasNumeric = true
                    }
                }
            }
        }

        def parsed (SliceParsedValue.fromContextEntry(cv))
        out.setSliceValue(parsed)
        slice.setSliceValue(parsed)
        return out
    }
}