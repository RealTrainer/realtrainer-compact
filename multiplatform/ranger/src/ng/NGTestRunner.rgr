Import "detectors/TokenDetector.rgr"
Import "StandardDetectors.rgr"
Import "Parser.rgr"
Import "JSON.rgr"

class NGExpectRule {
    def testIndex:int -1
    def negated:boolean false
    def kind:string ""
    def childIndex:int -1
    def field:string ""
    def value:string ""
}

class NGTestCase {
    def input:string ""
    def expects:[NGExpectRule]
    def jsonFile:string ""
}

class NGTestSpecParser {
    sfn create:NGTestSpecParser () {
        return (new NGTestSpecParser())
    }

    fn isSpace:boolean (ch:int) {
        if (ch == 32) {
            return true
        }
        if (ch == 9) {
            return true
        }
        return false
    }

    fn trim:string (text:string) {
        def len (strlen text)
        if (len == 0) {
            return ""
        }

        def start@(mutable):int 0
        while (start < len) {
            def ch (charAt text start)
            if (this.isSpace(ch)) {
                start = start + 1
            } {
                break
            }
        }

        def stop@(mutable):int len
        while (stop > start) {
            def ch2 (charAt text (stop - 1))
            if (this.isSpace(ch2)) {
                stop = stop - 1
            } {
                break
            }
        }

        if (stop <= start) {
            return ""
        }
        return (substring text start stop)
    }

    fn startsWith:boolean (text:string prefix:string) {
        def tLen (strlen text)
        def pLen (strlen prefix)
        if (pLen > tLen) {
            return false
        }
        return ((substring text 0 pLen) == prefix)
    }

    fn endsWith:boolean (text:string suffix:string) {
        def tLen (strlen text)
        def sLen (strlen suffix)
        if (sLen > tLen) {
            return false
        }
        return ((substring text (tLen - sLen) tLen) == suffix)
    }

    fn normalizeNumericText:string (text:string) {
        if (this.endsWith(text ".0")) {
            return (substring text 0 ((strlen text) - 2))
        }
        return text
    }

    fn isCommentLine:boolean (line:string) {
        return (this.startsWith(line "//"))
    }

    fn findSpace:int (text:string) {
        def len (strlen text)
        def i@(mutable):int 0
        while (i < len) {
            def ch (charAt text i)
            if (ch == 32) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn decodeEscapes:string (text:string) {
        def len (strlen text)
        if (len == 0) {
            return ""
        }

        def out@(mutable):string ""
        def i@(mutable):int 0
        while (i < len) {
            def ch (charAt text i)
            if ((ch == 92) && ((i + 1) < len)) {
                def next (charAt text (i + 1))
                if (next == 110) {
                    out = (out + "\n")
                    i = i + 2
                    continue
                }
                if (next == 114) {
                    out = (out + "\r")
                    i = i + 2
                    continue
                }
                if (next == 116) {
                    out = (out + "\t")
                    i = i + 2
                    continue
                }
                if (next == 92) {
                    out = (out + "\\")
                    i = i + 2
                    continue
                }
            }
            out = (out + (substring text i (i + 1)))
            i = i + 1
        }
        return out
    }

    fn parseExpect:NGExpectRule (line:string) {
        def out (new NGExpectRule())
        def payload (this.trim(line))
        if ((strlen payload) == 0) {
            return out
        }

        def body:string payload
        def idxSep (this.findSpace(payload))
        if (idxSep > 0) {
            def idxText (substring payload 0 idxSep)
            def idxSlice (TokenSlice.fromText(idxText))
            if ((idxSlice.length()) > 0) {
                if (idxSlice.hasInteger(0 ((idxSlice.length()) - 1))) {
                    out.testIndex = (idxSlice.parseInteger(0 ((idxSlice.length()) - 1)))
                    body = (this.trim((substring payload (idxSep + 1) (strlen payload))))
                }
            }
        }

        if (this.startsWith(body "not ")) {
            out.negated = true
            body = (this.trim((substring body 4 (strlen body))))
        }

        if (this.startsWith(body "tag ")) {
            out.kind = "tag"
            out.value = (this.decodeEscapes((this.trim((substring body 4 (strlen body))))))
            return out
        }

        if (this.startsWith(body "child ")) {
            def rest (this.trim((substring body 6 (strlen body))))
            def childIdxSep (this.findSpace(rest))
            if (childIdxSep < 0) {
                return out
            }

            def childIdxText (substring rest 0 childIdxSep)
            def childIdxSlice (TokenSlice.fromText(childIdxText))
            if ((childIdxSlice.length()) == 0) {
                return out
            }
            if (childIdxSlice.hasInteger(0 ((childIdxSlice.length()) - 1))) {
            } {
                return out
            }

            out.childIndex = (childIdxSlice.parseInteger(0 ((childIdxSlice.length()) - 1)))

            def afterIdx (this.trim((substring rest (childIdxSep + 1) (strlen rest))))
            def fieldSep (this.findSpace(afterIdx))
            if (fieldSep < 0) {
                return out
            }

            out.kind = "child"
            out.field = (substring afterIdx 0 fieldSep)
            out.value = (this.decodeEscapes((this.trim((substring afterIdx (fieldSep + 1) (strlen afterIdx))))))
            return out
        }

        if (this.startsWith(body "json ")) {
            def restJson (this.trim((substring body 5 (strlen body))))
            def pathSep (this.findSpace(restJson))
            if (pathSep < 0) {
                return out
            }
            out.kind = "json"
            out.field = (this.trim((substring restJson 0 pathSep)))
            out.value = (this.decodeEscapes((this.trim((substring restJson (pathSep + 1) (strlen restJson))))))
            return out
        }

        return out
    }

    fn resolveTargetIndex:int (blockStart:int caseCount:int idx:int) {
        if (idx >= 0) {
            return (blockStart + idx)
        }
        return (caseCount - 1)
    }

    fn parseJsonFile:void (line:string cases:[NGTestCase] blockStart:int) {
        def payload (this.trim(line))
        if ((strlen payload) == 0) {
            return
        }

        if (this.startsWith(payload "all ")) {
            def allFileName (this.decodeEscapes((this.trim((substring payload 4 (strlen payload))))))
            if ((strlen allFileName) == 0) {
                return
            }

            def from@(mutable):int blockStart
            def to (size cases)
            while (from < to) {
                def tcAll (itemAt cases from)
                tcAll.jsonFile = allFileName
                from = from + 1
            }
            return
        }

        def target@(mutable):int -1
        def fileName:string payload

        def idxSep (this.findSpace(payload))
        if (idxSep > 0) {
            def idxText (substring payload 0 idxSep)
            def idxSlice (TokenSlice.fromText(idxText))
            if ((idxSlice.length()) > 0) {
                if (idxSlice.hasInteger(0 ((idxSlice.length()) - 1))) {
                    def idxValue (idxSlice.parseInteger(0 ((idxSlice.length()) - 1)))
                    target = (this.resolveTargetIndex(blockStart (size cases) idxValue))
                    fileName = (this.trim((substring payload (idxSep + 1) (strlen payload))))
                }
            }
        }

        if (target < 0) {
            target = (this.resolveTargetIndex(blockStart (size cases) -1))
        }

        if ((strlen fileName) == 0) {
            return
        }

        if ((target >= 0) && (target < (size cases))) {
            def tc (itemAt cases target)
            tc.jsonFile = (this.decodeEscapes(fileName))
        }
    }

    fn parse:[NGTestCase] (specText:string) {
        def cases:[NGTestCase]
        def blockStart@(mutable):int 0
        def prevKind@(mutable):string "none"

        def len (strlen specText)
        def lineStart@(mutable):int 0
        def i@(mutable):int 0

        while (i <= len) {
            if (i == len) {
            } {
                def ch (charAt specText i)
                if ((ch == 10) || (ch == 13)) {
                } {
                    i = i + 1
                    continue
                }
            }

            def raw (substring specText lineStart i)
            def line (this.trim(raw))

            if ((strlen line) > 0) {
                if (this.isCommentLine(line)) {
                } {
                if (this.startsWith(line "Test ")) {
                    if (prevKind != "test") {
                        blockStart = (size cases)
                    }
                    def tc (new NGTestCase())
                    tc.input = (this.decodeEscapes((this.trim((substring line 5 (strlen line))))))
                    push cases tc
                    prevKind = "test"
                } {
                    if (this.startsWith(line "Expect ")) {
                        def ex (this.parseExpect((substring line 7 (strlen line))))
                        if ((strlen ex.kind) > 0) {
                            def target (this.resolveTargetIndex(blockStart (size cases) ex.testIndex))

                            if ((target >= 0) && (target < (size cases))) {
                                def tc2 (itemAt cases target)
                                push tc2.expects ex
                            }
                        }
                        prevKind = "expect"
                    } {
                        if (this.startsWith(line "JSON ")) {
                            this.parseJsonFile((substring line 5 (strlen line)) cases blockStart)
                            prevKind = "json"
                        }
                    }
                }
                }
            }

            if (i == len) {
                break
            }

            def firstNl (charAt specText i)
            if ((firstNl == 13) && ((i + 1) < len)) {
                if ((charAt specText (i + 1)) == 10) {
                    i = i + 1
                }
            }
            i = i + 1
            lineStart = i
        }

        return cases
    }
}

class NGTestRunner {
    sfn create:NGTestRunner () {
        return (new NGTestRunner())
    }

    fn isSpace:boolean (ch:int) {
        if (ch == 32) {
            return true
        }
        if (ch == 9) {
            return true
        }
        return false
    }

    fn trim:string (text:string) {
        def len (strlen text)
        if (len == 0) {
            return ""
        }

        def start@(mutable):int 0
        while (start < len) {
            def ch (charAt text start)
            if (this.isSpace(ch)) {
                start = start + 1
            } {
                break
            }
        }

        def stop@(mutable):int len
        while (stop > start) {
            def ch2 (charAt text (stop - 1))
            if (this.isSpace(ch2)) {
                stop = stop - 1
            } {
                break
            }
        }

        if (stop <= start) {
            return ""
        }
        return (substring text start stop)
    }

    fn startsWith:boolean (text:string prefix:string) {
        def tLen (strlen text)
        def pLen (strlen prefix)
        if (pLen > tLen) {
            return false
        }
        return ((substring text 0 pLen) == prefix)
    }

    fn createDetectors:[TokenDetector] () {
        return (StandardDetectors.create())
    }

    fn escapeJson:string (text:string) {
        def len (strlen text)
        if (len == 0) {
            return ""
        }

        def out@(mutable):string ""
        def i@(mutable):int 0
        while (i < len) {
            def ch (charAt text i)
            if (ch == 34) {
                out = (out + "\\\"")
                i = i + 1
                continue
            }
            if (ch == 92) {
                out = (out + "\\\\")
                i = i + 1
                continue
            }
            if (ch == 10) {
                out = (out + "\\n")
                i = i + 1
                continue
            }
            if (ch == 13) {
                out = (out + "\\r")
                i = i + 1
                continue
            }
            if (ch == 9) {
                out = (out + "\\t")
                i = i + 1
                continue
            }

            out = (out + (substring text i (i + 1)))
            i = i + 1
        }
        return out
    }

    fn indent:string (level:int) {
        def out@(mutable):string ""
        def i@(mutable):int 0
        while (i < level) {
            out = (out + "  ")
            i = i + 1
        }
        return out
    }

    fn jsonKVString:string (key:string value:string) {
        return ("\"" + key + "\":\"" + (this.escapeJson(value)) + "\"")
    }

    fn jsonKVNumber:string (key:string value:string) {
        return ("\"" + key + "\":" + value)
    }

    fn jsonObject:string (level:int fields:[string]) {
        def pad (this.indent(level))
        def childPad (this.indent(level + 1))
        def out@(mutable):string "{\n"
        def cnt (size fields)
        def i@(mutable):int 0
        while (i < cnt) {
            out = (out + childPad + (itemAt fields i))
            if ((i + 1) < cnt) {
                out = (out + ",")
            }
            out = (out + "\n")
            i = i + 1
        }
        out = (out + pad + "}")
        return out
    }

    fn parsedValueToJson:string (token:TokenSlice level:int) {
        if (token.hasSliceValue()) {
        } {
            return "null"
        }

        def kind (token.getSliceValueKind())

        if (kind == "datetime") {
            return (to_string((token.getAsDateTimeValue().toDictionary())))
        }
        if (kind == "distance") {
            return (to_string((token.getAsDistanceValue().toDictionary())))
        }
        if (kind == "percentage") {
            return (to_string((token.getAsPercentageValue().toDictionary())))
        }
        if (kind == "recovery-time") {
            return (to_string((token.getAsRecoveryTimeValue().toDictionary())))
        }
        if (kind == "time-value") {
            return (to_string((token.getAsTimeValueValue().toDictionary())))
        }
        if (kind == "weight") {
            return (to_string((token.getAsWeightValue().toDictionary())))
        }
        if (kind == "num-range") {
            return (to_string((token.getAsNumRangeValue().toDictionary())))
        }
        if (kind == "percentage-range") {
            return (to_string((token.getAsPercentageRangeValue().toDictionary())))
        }
        if (kind == "repeat-block") {
            return (to_string((token.getAsRepeatBlockValue().toDictionary())))
        }
        if (kind == "set-rep-range-load") {
            return (to_string((token.getAsSetRepRangeLoadValue().toDictionary())))
        }
        if (kind == "zone") {
            return (to_string((token.getAsZoneValue().toDictionary())))
        }
        if (kind == "positive-integer") {
            return (to_string((token.getAsPositiveIntegerValue().toDictionary())))
        }
        if (kind == "details-level") {
            return (to_string((token.getAsDetailsLevelValue().toDictionary())))
        }
        if (kind == "recovery") {
            return (to_string((token.getAsRecoveryValue().toDictionary())))
        }
        if (kind == "left-right") {
            return (to_string((token.getAsLeftRightValue().toDictionary())))
        }
        if (kind == "feeling") {
            return (to_string((token.getAsFeelingValue().toDictionary())))
        }
        if (kind == "body-metric") {
            return (to_string((token.getAsBodyMetricValue().toDictionary())))
        }
        if (kind == "circuit") {
            return (to_string((token.getAsCircuitValue().toDictionary())))
        }
        if (kind == "context-entry") {
            return (to_string((token.getAsContextEntryValue().toDictionary())))
        }

        return ("{\"kind\":\"" + (this.escapeJson(kind)) + "\"}")
    }

    fn tokenToJson:string (token:TokenSlice level:int) {
        def pad (this.indent(level))
        def childPad (this.indent(level + 1))
        def out@(mutable):string (pad + "{\n")
        out = (out + (childPad + ("\"tag\":\"" + (this.escapeJson(token.tag)) + "\",\n")))
        out = (out + (childPad + ("\"text\":\"" + (this.escapeJson((token.toString()))) + "\",\n")))
        out = (out + (childPad + "\"parsed\":" + (this.parsedValueToJson(token (level + 1))) + ",\n"))
        out = (out + (childPad + "\"children\":["))

        def cc (token.childCount())
        def i@(mutable):int 0
        if (cc > 0) {
            out = (out + "\n")
            while (i < cc) {
                if (i > 0) {
                    out = (out + ",\n")
                }
                def ch (token.getChild(i))
                out = (out + (this.tokenToJson(ch (level + 2))))
                i = i + 1
            }
            out = (out + "\n")
            out = (out + childPad)
        }

        out = (out + "]\n")
        out = (out + (pad + "}"))
        return out
    }

    fn findDot:int (text:string) {
        def len (strlen text)
        def i@(mutable):int 0
        while (i < len) {
            if ((charAt text i) == 46) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn normalizeJsonPath:string (path:string) {
        def raw (this.trim(path))
        if ((strlen raw) == 0) {
            return ""
        }

        def out@(mutable):string ""
        def len (strlen raw)
        def i@(mutable):int 0

        if (raw == "$") {
            return ""
        }

        if (this.startsWith(raw "$.")) {
            i = 2
        } {
            if (this.startsWith(raw "$")) {
                i = 1
            }
        }

        while (i < len) {
            def ch (charAt raw i)
            if (ch == 91) {
                i = i + 1
                if ((strlen out) > 0) {
                    out = (out + ".")
                }
                while (i < len) {
                    def ch2 (charAt raw i)
                    if (ch2 == 93) {
                        i = i + 1
                        break
                    }
                    out = (out + (substring raw i (i + 1)))
                    i = i + 1
                }
                continue
            }
            out = (out + (substring raw i (i + 1)))
            i = i + 1
        }

        if (this.startsWith(out ".")) {
            out = (substring out 1 (strlen out))
        }

        return out
    }

    fn jsonTokenValue:string (token:TokenSlice path:string) {
        def p (this.normalizeJsonPath(path))
        if ((strlen p) == 0) {
            return ""
        }

        def dotPos (this.findDot(p))
        def head:string p
        def tail:string ""
        if (dotPos >= 0) {
            head = (substring p 0 dotPos)
            tail = (substring p (dotPos + 1) (strlen p))
        }

        if (head == "tag") {
            if ((strlen tail) == 0) {
                return token.tag
            }
            return ""
        }

        if (head == "text") {
            if ((strlen tail) == 0) {
                return (token.toString())
            }
            return ""
        }

        if (head == "children") {
            if ((strlen tail) == 0) {
                return ""
            }

            def dotPos2 (this.findDot(tail))
            def idxText:string tail
            def rest:string ""
            if (dotPos2 >= 0) {
                idxText = (substring tail 0 dotPos2)
                rest = (substring tail (dotPos2 + 1) (strlen tail))
            }

            def idxSlice (TokenSlice.fromText(idxText))
            if ((idxSlice.length()) == 0) {
                return ""
            }
            if (idxSlice.hasInteger(0 ((idxSlice.length()) - 1))) {
            } {
                return ""
            }

            def childIdx (idxSlice.parseInteger(0 ((idxSlice.length()) - 1)))
            if ((childIdx < 0) || (childIdx >= (token.childCount()))) {
                return ""
            }

            def ch (token.getChild(childIdx))
            if ((strlen rest) == 0) {
                return (ch.toString())
            }
            return (this.jsonTokenValue(ch rest))
        }

        if (head == "parsed") {
            if ((strlen tail) == 0) {
                return (token.getSliceValueKind())
            }

            if (token.hasSliceValue()) {
            } {
                return ""
            }

            def kind (token.getSliceValueKind())
            if (tail == "kind") {
                return kind
            }

            if (kind == "recovery-time") {
                def rv (token.getAsRecoveryTimeValue())
                if (tail == "value") {
                    return ("" + rv.value)
                }
                if (tail == "unit") {
                    return rv.unit
                }
            }

            if (kind == "time-value") {
                def tv (token.getAsTimeValueValue())
                if (tail == "minutes") {
                    return ("" + tv.minutes)
                }
                if (tail == "seconds") {
                    return ("" + tv.seconds)
                }
            }

            if (kind == "datetime") {
                def dtv (token.getAsDateTimeValue())
                if (tail == "year") {
                    return ("" + dtv.year)
                }
                if (tail == "month") {
                    return ("" + dtv.month)
                }
                if (tail == "day") {
                    return ("" + dtv.day)
                }
                if (tail == "hour") {
                    return ("" + dtv.hour)
                }
                if (tail == "minute") {
                    return ("" + dtv.minute)
                }
                if (tail == "second") {
                    return ("" + dtv.second)
                }
                if (tail == "timezone") {
                    if (!null? dtv.timezone) {
                        return (unwrap dtv.timezone)
                    }
                    return ""
                }
            }

            if (kind == "distance") {
                def dv (token.getAsDistanceValue())
                if (tail == "value") {
                    return ("" + dv.value)
                }
                if (tail == "unit") {
                    return dv.unit
                }
            }

            if (kind == "weight") {
                def wv (token.getAsWeightValue())
                if (tail == "value") {
                    return ("" + wv.value)
                }
                if (tail == "unit") {
                    return wv.unit
                }
            }

            if (kind == "percentage") {
                def pv (token.getAsPercentageValue())
                if (tail == "value") {
                    return ("" + pv.value)
                }
            }

            if (kind == "num-range") {
                def nr (token.getAsNumRangeValue())
                if (tail == "minValue") {
                    return ("" + nr.minValue)
                }
                if (tail == "maxValue") {
                    return ("" + nr.maxValue)
                }
            }

            if (kind == "percentage-range") {
                def pr (token.getAsPercentageRangeValue())
                if (tail == "minValue") {
                    return ("" + pr.minValue)
                }
                if (tail == "maxValue") {
                    return ("" + pr.maxValue)
                }
            }

            if (kind == "zone") {
                def zv (token.getAsZoneValue())
                if (tail == "zone") {
                    return ("" + zv.zone)
                }
            }

            if (kind == "repeat-block") {
                def rb (token.getAsRepeatBlockValue())
                if (tail == "count") {
                    return ("" + rb.count)
                }
            }

            if (kind == "left-right") {
                def lr (token.getAsLeftRightValue())
                if (tail == "side") {
                    return lr.side
                }
            }

            if (kind == "set-rep-range-load") {
                def sr (token.getAsSetRepRangeLoadValue())
                if (tail == "setsMin") {
                    return ("" + sr.setsMin)
                }
                if (tail == "setsMax") {
                    return ("" + sr.setsMax)
                }
                if (tail == "repsMin") {
                    return ("" + sr.repsMin)
                }
                if (tail == "repsMax") {
                    return ("" + sr.repsMax)
                }
                if (tail == "mode") {
                    return sr.mode
                }
                if (tail == "load") {
                    return ("" + sr.load)
                }
                if (tail == "unit") {
                    return sr.unit
                }
            }

            if (kind == "feeling") {
                def fv (token.getAsFeelingValue())
                if (tail == "type") {
                    return fv.kind
                }
                if (tail == "score") {
                    return ("" + fv.score)
                }
            }

            if (kind == "body-metric") {
                def bm (token.getAsBodyMetricValue())
                if (tail == "metric") {
                    return bm.metric
                }
                if (tail == "primaryValue") {
                    return ("" + bm.primaryValue)
                }
                if (tail == "secondaryValue") {
                    return ("" + bm.secondaryValue)
                }
                if (tail == "unit") {
                    return bm.unit
                }
            }

            if (kind == "circuit") {
                def cv (token.getAsCircuitValue())
                if (tail == "rounds") {
                    return ("" + cv.rounds)
                }
                if (tail == "restValue") {
                    return ("" + cv.restValue)
                }
                if (tail == "restUnit") {
                    return cv.restUnit
                }
            }

            if (kind == "details-level") {
                def dl (token.getAsDetailsLevelValue())
                if (tail == "level") {
                    return ("" + dl.level)
                }
                if (tail == "marker") {
                    return dl.marker
                }
            }

            if (kind == "recovery") {
                def rv2 (token.getAsRecoveryValue())
                if (tail == "label") {
                    return rv2.label
                }
            }

            if (kind == "context-entry") {
                def ce (token.getAsContextEntryValue())
                if (tail == "type") {
                    return ce.kind
                }
                if (tail == "content") {
                    return ce.content
                }
            }

            if (kind == "positive-integer") {
                def piv (token.getAsPositiveIntegerValue())
                if (tail == "value") {
                    return ("" + piv.value)
                }
            }
            return ""
        }

        return ""
    }

    fn runSpec:[string] (specText:string) {
        def out:[string]
        def parser (NGTestSpecParser.create())
        def cases (parser.parse(specText))

        for cases tc:NGTestCase i {
            def p (new Parser(tc.input (this.createDetectors())))
            p.start()

            if ((p.getCount()) == 0) {
                push out (((("Test " + ("#" + ("" + (i + 1)))) + " failed: no tokens for input '") + tc.input) + "'")
                continue
            }

            def results (p.getResults())
            def root (itemAt results 0)

            for tc.expects ex:NGExpectRule j {
                if (ex.kind == "tag") {
                    def tagMatches (root.tag == ex.value)
                    if (ex.negated) {
                        if (tagMatches) {
                            def msgNotTag ((("Test " + ("#" + ("" + (i + 1)))) + " expect not tag '") + ex.value)
                            push out (msgNotTag + "' but it matched")
                        }
                    } {
                        if (tagMatches) {
                        } {
                            def msgTag ((("Test " + ("#" + ("" + (i + 1)))) + " expect tag '") + ex.value)
                            push out ((msgTag + "' but got '") + root.tag + "'")
                        }
                    }
                    continue
                }

                if (ex.kind == "child") {
                    if ((ex.childIndex < 0) || (ex.childIndex >= (root.childCount()))) {
                        push out (((("Test " + ("#" + ("" + (i + 1)))) + " expect child index out of range: ") + ("" + ex.childIndex)) + ((" childCount=" + ("" + (root.childCount()))) + ""))
                        continue
                    }

                    def ch (root.getChild(ex.childIndex))
                    if (ex.field == "string") {
                        def got (ch.toString())
                        def strMatches (got == ex.value)
                        if (ex.negated) {
                            if (strMatches) {
                                def msgNotStr ((((("Test " + ("#" + ("" + (i + 1)))) + " expect child ") + ("" + ex.childIndex)) + " not string '") + ex.value)
                                push out (msgNotStr + "' but it matched")
                            }
                        } {
                            if (strMatches) {
                            } {
                                def msgStr ((((("Test " + ("#" + ("" + (i + 1)))) + " expect child ") + ("" + ex.childIndex)) + " string '") + ex.value)
                                push out ((msgStr + "' but got '") + got + "'")
                            }
                        }
                        continue
                    }

                    if (ex.field == "tag") {
                        def gotTag (ch.tag)
                        def tagMatches (gotTag == ex.value)
                        if (ex.negated) {
                            if (tagMatches) {
                                def msgNotTag ((((("Test " + ("#" + ("" + (i + 1)))) + " expect child ") + ("" + ex.childIndex)) + " not tag '") + ex.value)
                                push out (msgNotTag + "' but it matched")
                            }
                        } {
                            if (tagMatches) {
                            } {
                                def msgTag ((((("Test " + ("#" + ("" + (i + 1)))) + " expect child ") + ("" + ex.childIndex)) + " tag '") + ex.value)
                                push out ((msgTag + "' but got '") + gotTag + "'")
                            }
                        }
                        continue
                    }

                    push out (((("Test " + ("#" + ("" + (i + 1)))) + " unsupported field '") + ex.field) + "' in Expect child")
                    continue
                }

                if (ex.kind == "json") {
                    def gotJson (this.jsonTokenValue(root ex.field))
                    if ((strlen gotJson) == 0) {
                        if (ex.negated) {
                            continue
                        }
                        push out (((("Test " + ("#" + ("" + (i + 1)))) + " expect json path '") + ex.field) + "' was not found")
                        continue
                    }
                    def jsonMatches (gotJson == ex.value)
                    if (ex.negated) {
                        if (jsonMatches) {
                            def msgNotJson (((("Test " + ("#" + ("" + (i + 1)))) + " expect json path '") + ex.field) + "' not to be '")
                            push out ((msgNotJson + ex.value) + "' but it matched")
                        }
                    } {
                        if (jsonMatches) {
                        } {
                            def msgJson (((("Test " + ("#" + ("" + (i + 1)))) + " expect json path '") + ex.field) + "' value '")
                            push out (((msgJson + ex.value) + "' but got '") + gotJson + "'")
                        }
                    }
                    continue
                }
            }
        }

        return out
    }

    fn exportJson:[string] (specText:string) {
        def out:[string]
        def parser (NGTestSpecParser.create())
        def cases (parser.parse(specText))

        def files:[string]
        def payloads:[string]
        def counts:[int]

        for cases tc:NGTestCase i {
            if ((strlen tc.jsonFile) == 0) {
                continue
            }

            def p (new Parser(tc.input (this.createDetectors())))
            p.start()
            if ((p.getCount()) == 0) {
                continue
            }

            def results (p.getResults())
            def root (itemAt results 0)
            def json (this.tokenToJson(root 0))

            def fileIdx@(mutable):int -1
            def search@(mutable):int 0
            while (search < (size files)) {
                if ((itemAt files search) == tc.jsonFile) {
                    fileIdx = search
                    break
                }
                search = search + 1
            }

            if (fileIdx < 0) {
                push files tc.jsonFile
                push payloads json
                push counts 1
            } {
                def prevPayload (itemAt payloads fileIdx)
                def nextPayload (prevPayload + ",\n" + json)
                set payloads fileIdx nextPayload
                def prevCount (itemAt counts fileIdx)
                set counts fileIdx (prevCount + 1)
            }
        }

        def j@(mutable):int 0
        while (j < (size files)) {
            def fileName (itemAt files j)
            def payload (itemAt payloads j)
            def cnt (itemAt counts j)
            if (cnt > 1) {
                payload = ("[\n" + payload + "\n]")
            }
            push out (fileName + "\t" + payload)
            j = j + 1
        }

        return out
    }
}
