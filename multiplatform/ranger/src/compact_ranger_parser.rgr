class CompactAstJson {
    static fn escape:string (value:string) {
        def out@(mutable):string ""
        def len (strlen value)
        def i@(mutable):int 0
        while (i < len) {
            def ch (charAt value i)
            if (ch == (ccode "\\")) {
                out = (out + "\\\\")
            } {
                if (ch == (ccode "\"")) {
                    out = (out + "\\\"")
                } {
                    if (ch == 10) {
                        out = (out + "\\n")
                    } {
                        if (ch == 13) {
                            out = (out + "\\r")
                        } {
                            if (ch == 9) {
                                out = (out + "\\t")
                            } {
                                out = (out + (substring value i (i + 1)))
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
        return out
    }

    static fn quote:string (value:string) {
        return ("\"" + (CompactAstJson.escape(value)) + "\"")
    }

    static fn boolValue:string (value:boolean) {
        if (value) {
            return "true"
        }
        return "false"
    }

    static fn field:string (name:string rawValue:string) {
        return ((CompactAstJson.quote(name)) + ":" + rawValue)
    }

    static fn jsonObject:string (fields:[string]) {
        return ("{" + (join fields ",") + "}")
    }

    static fn addRawField:void (fields@(mutates):[string] name:string rawValue:string) {
        push fields (CompactAstJson.field(name rawValue))
    }

    static fn addStringField:void (fields@(mutates):[string] name:string value:string) {
        push fields (CompactAstJson.field(name (CompactAstJson.quote(value))))
    }

    static fn addIntField:void (fields@(mutates):[string] name:string value:int) {
        push fields (CompactAstJson.field(name (to_string value)))
    }

    static fn addDoubleField:void (fields@(mutates):[string] name:string value:double) {
        push fields (CompactAstJson.field(name (to_string value)))
    }

    static fn addBooleanField:void (fields@(mutates):[string] name:string value:boolean) {
        push fields (CompactAstJson.field(name (CompactAstJson.boolValue(value))))
    }

    static fn addOptionalStringField:void (fields@(mutates):[string] name:string value@(optional):string) {
        if (!null? value) {
            CompactAstJson.addStringField(fields name (unwrap value))
        }
    }

    static fn addOptionalIntField:void (fields@(mutates):[string] name:string value@(optional):int) {
        if (!null? value) {
            CompactAstJson.addIntField(fields name (unwrap value))
        }
    }

    static fn addOptionalDoubleField:void (fields@(mutates):[string] name:string value@(optional):double) {
        if (!null? value) {
            CompactAstJson.addDoubleField(fields name (unwrap value))
        }
    }

    static fn addOptionalBooleanField:void (fields@(mutates):[string] name:string value@(optional):boolean) {
        if (!null? value) {
            CompactAstJson.addBooleanField(fields name (unwrap value))
        }
    }

    static fn stringArray:string (values:[string]) {
        def items:[string]
        for values item:string i {
            push items (CompactAstJson.quote(item))
        }
        return ("[" + (join items ",") + "]")
    }

    static fn intArray:string (values:[int]) {
        def items:[string]
        for values item:int i {
            push items (to_string item)
        }
        return ("[" + (join items ",") + "]")
    }

    static fn nodeArray:string (values:[AstNode]) {
        def items:[string]
        for values item:AstNode i {
            push items (item.toJSONString())
        }
        return ("[" + (join items ",") + "]")
    }

    static fn attemptArray:string (values:[ExerciseAttemptNode]) {
        def items:[string]
        for values item:ExerciseAttemptNode i {
            push items (item.toJSONString())
        }
        return ("[" + (join items ",") + "]")
    }

    static fn workoutArray:string (values:[WorkoutNode]) {
        def items:[string]
        for values item:WorkoutNode i {
            push items (item.toJSONString())
        }
        return ("[" + (join items ",") + "]")
    }

    static fn addStringArrayField:void (fields@(mutates):[string] name:string values:[string]) {
        def raw:string (CompactAstJson.stringArray(values))
        CompactAstJson.addRawField(fields name raw)
    }

    static fn addIntArrayField:void (fields@(mutates):[string] name:string values:[int]) {
        def raw:string (CompactAstJson.intArray(values))
        CompactAstJson.addRawField(fields name raw)
    }

    static fn addNodeArrayField:void (fields@(mutates):[string] name:string values:[AstNode]) {
        def raw:string (CompactAstJson.nodeArray(values))
        CompactAstJson.addRawField(fields name raw)
    }

    static fn addAttemptArrayField:void (fields@(mutates):[string] name:string values:[ExerciseAttemptNode]) {
        def raw:string (CompactAstJson.attemptArray(values))
        CompactAstJson.addRawField(fields name raw)
    }

    static fn addWorkoutArrayField:void (fields@(mutates):[string] name:string values:[WorkoutNode]) {
        def raw:string (CompactAstJson.workoutArray(values))
        CompactAstJson.addRawField(fields name raw)
    }

    static fn addDistanceField:void (fields@(mutates):[string] name:string value:DistanceNode) {
        def raw:string (value.toJSONString())
        CompactAstJson.addRawField(fields name raw)
    }

    static fn addQuantityField:void (fields@(mutates):[string] name:string value:QuantityNode) {
        def raw:string (value.toJSONString())
        CompactAstJson.addRawField(fields name raw)
    }

    static fn addRepeatsField:void (fields@(mutates):[string] name:string value:RepeatsNode) {
        def raw:string (value.toJSONString())
        CompactAstJson.addRawField(fields name raw)
    }

    static fn addDateField:void (fields@(mutates):[string] name:string value:DateValueNode) {
        def raw:string (value.toJSONString())
        CompactAstJson.addRawField(fields name raw)
    }
}

class AstNode {
    def type:string ""

    fn toJSONString@(open):string () {
        def fields:[string]
        CompactAstJson.addStringField(fields "type" type)
        return (CompactAstJson.jsonObject(fields))
    }
}

