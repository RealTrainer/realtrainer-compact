class CompactAstParser {

    fn startsWith:boolean (s:string prefix:string) {
        def sLen (strlen s)
        def pLen (strlen prefix)
        if (sLen < pLen) {
            return false
        }
        return ((substring s 0 pLen) == prefix)
    }

    fn findToken:int (s:string token:string) {
        def sLen (strlen s)
        def tLen (strlen token)
        if (tLen == 0) {
            return 0
        }
        if (sLen < tLen) {
            return -1
        }

        def i@(mutable):int 0
        while (i <= (sLen - tLen)) {
            if ((substring s i (i + tLen)) == token) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    fn endsWith:boolean (s:string suffix:string) {
        def sLen (strlen s)
        def pLen (strlen suffix)
        if (sLen < pLen) {
            return false
        }
        return ((substring s (sLen - pLen) sLen) == suffix)
    }

    fn parseDateFromHeader:DateValueNode (line:string hashPos:int) {
        def d (new DateValueNode)
        def leftPart (trim (substring line 0 hashPos))
        def lLen (strlen leftPart)
        if (lLen < 2) {
            return d
        }

        def firstC (charAt leftPart 0)
        def lastC (charAt leftPart (lLen - 1))
        if (!((firstC == (ccode "[")) && (lastC == (ccode "]")))) {
            return d
        }

        def inner (trim (substring leftPart 1 (lLen - 1)))
        def parts (strsplit inner "-")
        if ((array_length parts) != 3) {
            return d
        }

        def yOpt (str2int (trim (itemAt parts 0)))
        def mOpt (str2int (trim (itemAt parts 1)))
        def dOpt (str2int (trim (itemAt parts 2)))
        if (null? yOpt) {
            return d
        }
        if (null? mOpt) {
            return d
        }
        if (null? dOpt) {
            return d
        }

        d.year = (unwrap yOpt)
        d.month = (unwrap mOpt)
        d.day = (unwrap dOpt)
        d.unknown = false
        return d
    }

    fn parseTitleFromHeader:string (line:string hashPos:int) {
        def lineLen (strlen line)
        def titlePart (trim (substring line (hashPos + 2) lineLen))
        if ((strlen titlePart) > 0) {
            return titlePart
        }
        return "Untitled"
    }

    fn parseDistanceToken:DistanceNode (token:string) {
        def out (new DistanceNode)
        def t (trim token)
        if ((strlen t) == 0) {
            return out
        }

        def units:[string]
        push units "km"
        push units "mi"
        push units "yd"
        push units "ft"
        push units "m"

        for units unit:string i {
            if (this.endsWith(t unit)) {
                def tLen (strlen t)
                def uLen (strlen unit)
                if (tLen <= uLen) {
                    continue
                }

                def numPart (trim (substring t 0 (tLen - uLen)))
                def numericTok (this.isNumericToken(numPart))
                if (numericTok == false) {
                    continue
                }
                def numOpt (str2double numPart)
                if (null? numOpt) {
                    continue
                }

                def d (new DistanceNode)
                d.value = (unwrap numOpt)
                d.unit = unit
                return d
            }
        }

        return out
    }

    fn parseDistanceRangeToken:DistanceNode (token:string) {
        def out (new DistanceNode)
        def t (trim token)
        if ((strlen t) == 0) {
            return out
        }

        def units:[string]
        push units "km"
        push units "mi"
        push units "yd"
        push units "ft"
        push units "m"

        for units unit:string i {
            if (this.endsWith(t unit)) {
                def tLen (strlen t)
                def uLen (strlen unit)
                if (tLen <= uLen) {
                    continue
                }

                def numPart (trim (substring t 0 (tLen - uLen)))
                def dashPos (this.findToken(numPart "-"))
                if (dashPos > 0) {
                    def left (trim (substring numPart 0 dashPos))
                    def right (trim (substring numPart (dashPos + 1) (strlen numPart)))
                    def leftOpt (str2double left)
                    def rightOpt (str2double right)
                    if ((!null? leftOpt) && (!null? rightOpt)) {
                        out.value = (unwrap leftOpt)
                        out.valueMax = (unwrap rightOpt)
                        out.unit = unit
                        return out
                    }
                }

                def singleOpt (str2double numPart)
                if (!null? singleOpt) {
                    out.value = (unwrap singleOpt)
                    out.unit = unit
                    return out
                }
            }
        }

        return out
    }

    fn isNumericToken:boolean (s:string) {
        def t (trim s)
        if ((strlen t) == 0) {
            return false
        }

        def i@(mutable):int 0
        while (i < (strlen t)) {
            def ch (charAt t i)
            def ok:boolean false
            if ((ch >= (ccode "0")) && (ch <= (ccode "9"))) {
                ok = true
            }
            if ((ch == (ccode ".")) || (ch == (ccode "-"))) {
                ok = true
            }
            if (ok == false) {
                return false
            }
            i = i + 1
        }
        return true
    }

    fn isAsciiLetter:boolean (ch:int) {
        if ((ch >= (ccode "A")) && (ch <= (ccode "Z"))) {
            return true
        }
        if ((ch >= (ccode "a")) && (ch <= (ccode "z"))) {
            return true
        }
        return false
    }

    fn isSportToken:boolean (token:string) {
        def t (trim token)
        if ((strlen t) == 0) {
            return false
        }

        def first (charAt t 0)
        if (!((first >= (ccode "A")) && (first <= (ccode "Z")))) {
            return false
        }

        def i@(mutable):int 0
        while (i < (strlen t)) {
            def ch (charAt t i)
            def ok:boolean false
            if (this.isAsciiLetter(ch)) {
                ok = true
            }
            if ((ch == (ccode "-")) || (ch == (ccode "_"))) {
                ok = true
            }
            if (ok == false) {
                return false
            }
            i = i + 1
        }
        return true
    }

    fn isReservedTagToken:boolean (token:string) {
        if (token == "Format") {
            return true
        }
        if (token == "Tags") {
            return true
        }
        if (token == "Emojis") {
            return true
        }
        if (token == "Summary") {
            return true
        }
        if (token == "Text") {
            return true
        }
        if (token == "Derived") {
            return true
        }
        if (token == "Exercise") {
            return true
        }
        if (token == "Phase") {
            return true
        }
        if (token == "Section") {
            return true
        }
        if (token == "Time") {
            return true
        }
        if (token == "Duration") {
            return true
        }
        if (token == "Contacts") {
            return true
        }
        if (token == "Lift") {
            return true
        }
        if (token == "Endurance") {
            return true
        }
        if (token == "Reminder") {
            return true
        }
        if (token == "Feeling") {
            return true
        }
        if (token == "Feelings") {
            return true
        }
        if (token == "Pain") {
            return true
        }
        if (token == "Vitals") {
            return true
        }
        if (token == "Location") {
            return true
        }
        if (token == "URL") {
            return true
        }
        return false
    }

    fn isKnownSportToken:boolean (token:string) {
        if (token == "Run") {
            return true
        }
        if (token == "Swim") {
            return true
        }
        if (token == "Bike") {
            return true
        }
        if (token == "Cycle") {
            return true
        }
        if (token == "Ski") {
            return true
        }
        if (token == "Skijump") {
            return true
        }
        if (token == "Row") {
            return true
        }
        if (token == "Walk") {
            return true
        }
        if (token == "Hike") {
            return true
        }
        return false
    }

    fn hasDigit:boolean (s:string) {
        def i@(mutable):int 0
        while (i < (strlen s)) {
            def ch (charAt s i)
            if ((ch >= (ccode "0")) && (ch <= (ccode "9"))) {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn hasDynamicSportSignal:boolean (line:string sportToken:string) {
        def parts (strsplit line "|")
        def head (trim (itemAt parts 0))
        def sportLen (strlen sportToken)
        if ((strlen head) <= sportLen) {
            return false
        }

        def rest (trim (substring head sportLen (strlen head)))
        if ((strlen rest) == 0) {
            return false
        }

        def tokens (strsplit rest " ")
        for tokens tok:string i {
            def t (trim tok)
            if ((strlen t) == 0) {
                continue
            }

            def dNode (this.parseDistanceToken(t))
            if ((strlen dNode.unit) > 0) {
                return true
            }

            def dur (this.parseDurationToken(t))
            if ((strlen dur) > 0) {
                return true
            }

            if (this.hasDigit(t)) {
                return true
            }
        }
        return false
    }

    fn detectSportToken:string (line:string) {
        def lineLen (strlen line)
        if (lineLen == 0) {
            return ""
        }

        def spacePos (this.findToken(line " "))
        def pipePos (this.findToken(line "|"))
        def endPos@(mutable):int lineLen
        if (spacePos >= 0) {
            endPos = spacePos
        }
        if (pipePos >= 0) {
            if ((spacePos < 0) || (pipePos < endPos)) {
                endPos = pipePos
            }
        }

        def token (trim (substring line 0 endPos))
        def sportLike (this.isSportToken(token))
        if (sportLike == false) {
            return ""
        }
        if (this.isReservedTagToken(token)) {
            return ""
        }

        if (this.isKnownSportToken(token)) {
            return token
        }

        if (this.hasDynamicSportSignal(line token)) {
            return token
        }

        return ""
    }

    fn parseDurationToken:string (token:string) {
        def t (trim token)
        if ((strlen t) < 2) {
            return ""
        }

        def colonPos (this.findToken(t ":"))
        if (colonPos > 0) {
            def parts (strsplit t ":")
            if ((array_length parts) == 2) {
                def minPart (trim (itemAt parts 0))
                def secPart (trim (itemAt parts 1))
                def minOk (this.isNumericToken(minPart))
                def secOk (this.isNumericToken(secPart))
                if (minOk && secOk) {
                    return t
                }
            }
        }

        def aposPos (this.findToken(t "'"))
        if (aposPos > 0) {
            def tLen (strlen t)
            def minPart (trim (substring t 0 aposPos))
            def secPartRaw (trim (substring t (aposPos + 1) tLen))
            def secPart@(mutable):string secPartRaw
            if (this.endsWith(secPart "\"")) {
                def sLen (strlen secPart)
                if (sLen > 1) {
                    secPart = (trim (substring secPart 0 (sLen - 1)))
                }
            }
            def minOk (this.isNumericToken(minPart))
            def secOk (this.isNumericToken(secPart))
            if (minOk && secOk) {
                return t
            }
        }

        def minPos (this.findToken(t "min"))
        if (minPos > 0) {
            if (this.endsWith(t "s")) {
                def tLen (strlen t)
                if (tLen > (minPos + 4)) {
                    def minPart (trim (substring t 0 minPos))
                    def secPart (trim (substring t (minPos + 3) (tLen - 1)))
                    def minOk (this.isNumericToken(minPart))
                    def secOk (this.isNumericToken(secPart))
                    if (minOk && secOk) {
                        return t
                    }
                }
            }
        }

        def units:[string]
        push units "min"
        push units "sec"
        push units "h"
        push units "s"

        for units unit:string i {
            if (this.endsWith(t unit)) {
                def tLen (strlen t)
                def uLen (strlen unit)
                if (tLen <= uLen) {
                    continue
                }
                def numPart (trim (substring t 0 (tLen - uLen)))
                def numericTok (this.isNumericToken(numPart))
                if (numericTok) {
                    return t
                }
            }
        }
        return ""
    }

    fn parseDurationRangeToken:DurationRangeParseNode (token:string) {
        def out (new DurationRangeParseNode)
        def t (trim token)
        if ((strlen t) == 0) {
            return out
        }

        def single (this.parseDurationToken(t))
        if ((strlen single) > 0) {
            out.ok = true
            out.min = single
            return out
        }

        def dashPos (this.findToken(t "-"))
        if (dashPos > 0) {
            def left (trim (substring t 0 dashPos))
            def right (trim (substring t (dashPos + 1) (strlen t)))
            if ((strlen left) == 0) {
                return out
            }
            if ((strlen right) == 0) {
                return out
            }

            def leftDur (this.parseDurationToken(left))
            def rightDur (this.parseDurationToken(right))
            if (((strlen leftDur) > 0) && ((strlen rightDur) > 0)) {
                out.ok = true
                out.min = leftDur
                out.max = rightDur
            }
        }

        return out
    }

    fn parseDurationQuantity:QuantityNode (token:string) {
        def out (new QuantityNode)
        out.raw = (trim token)
        def t out.raw
        if ((strlen t) == 0) {
            return out
        }

        def minPos (this.findToken(t "min"))
        if (minPos > 0) {
            if (this.endsWith(t "s")) {
                def tLen (strlen t)
                if (tLen > (minPos + 4)) {
                    def minPart (trim (substring t 0 minPos))
                    def secPart (trim (substring t (minPos + 3) (tLen - 1)))
                    def minOpt (str2double minPart)
                    def secOpt (str2double secPart)
                    if ((!null? minOpt) && (!null? secOpt)) {
                        out.value = ((unwrap minOpt) * 60.0 + (unwrap secOpt))
                        out.unit = "s"
                        return out
                    }
                }
            }
        }

        def clockSecs (this.parseClockSeconds(t))
        if (clockSecs > 0.0) {
            out.value = clockSecs
            out.unit = "s"
            return out
        }

        def units:[string]
        push units "min"
        push units "sec"
        push units "h"
        push units "s"

        for units unit:string i {
            if (this.endsWith(t unit)) {
                def tLen (strlen t)
                def uLen (strlen unit)
                if (tLen <= uLen) {
                    continue
                }

                def numPart (trim (substring t 0 (tLen - uLen)))
                def dashPos (this.findToken(numPart "-"))
                if (dashPos > 0) {
                    def left (trim (substring numPart 0 dashPos))
                    def right (trim (substring numPart (dashPos + 1) (strlen numPart)))
                    def leftOpt (str2double left)
                    def rightOpt (str2double right)
                    if ((!null? leftOpt) && (!null? rightOpt)) {
                        out.value = (unwrap leftOpt)
                        out.valueMax = (unwrap rightOpt)
                        out.unit = unit
                        return out
                    }
                }

                def singleOpt (str2double numPart)
                if (!null? singleOpt) {
                    out.value = (unwrap singleOpt)
                    out.unit = unit
                    return out
                }
            }
        }

        return out
    }

    fn parseSuffixedQuantity:QuantityNode (token:string unit:string) {
        def out (new QuantityNode)
        out.raw = (trim token)
        def t out.raw
        if ((strlen t) == 0) {
            return out
        }
        def hasUnit:boolean (this.endsWith(t unit))
        if (hasUnit == false) {
            return out
        }

        def tLen (strlen t)
        def uLen (strlen unit)
        if (tLen <= uLen) {
            return out
        }

        def numPart (trim (substring t 0 (tLen - uLen)))
        def dashPos (this.findToken(numPart "-"))
        if (dashPos > 0) {
            def left (trim (substring numPart 0 dashPos))
            def right (trim (substring numPart (dashPos + 1) (strlen numPart)))
            def leftOpt (str2double left)
            def rightOpt (str2double right)
            if ((!null? leftOpt) && (!null? rightOpt)) {
                out.value = (unwrap leftOpt)
                out.valueMax = (unwrap rightOpt)
                out.unit = unit
                return out
            }
        }

        def oneOpt (str2double numPart)
        if (!null? oneOpt) {
            out.value = (unwrap oneOpt)
            out.unit = unit
        }

        return out
    }

    fn parseClockSeconds:double (token:string) {
        def t (trim token)
        if ((strlen t) == 0) {
            return -1.0
        }

        def colonPos (this.findToken(t ":"))
        if (colonPos > 0) {
            def parts (strsplit t ":")
            if ((array_length parts) == 2) {
                def minOpt (str2double (trim (itemAt parts 0)))
                def secOpt (str2double (trim (itemAt parts 1)))
                if ((!null? minOpt) && (!null? secOpt)) {
                    return ((unwrap minOpt) * 60.0 + (unwrap secOpt))
                }
            }
        }

        def aposPos (this.findToken(t "'"))
        if (aposPos > 0) {
            def tLen (strlen t)
            def minPart (trim (substring t 0 aposPos))
            def secPartRaw (trim (substring t (aposPos + 1) tLen))
            def secPart@(mutable):string secPartRaw
            if (this.endsWith(secPart "\"")) {
                def sLen (strlen secPart)
                if (sLen > 1) {
                    secPart = (trim (substring secPart 0 (sLen - 1)))
                }
            }
            def minOpt (str2double minPart)
            def secOpt (str2double secPart)
            if ((!null? minOpt) && (!null? secOpt)) {
                return ((unwrap minOpt) * 60.0 + (unwrap secOpt))
            }
        }

        return -1.0
    }

    fn inferDurationFromPace:string (paceToken:string distance@(optional):DistanceNode) {
        if (null? distance) {
            return ""
        }

        def t (trim paceToken)
        if ((strlen t) == 0) {
            return ""
        }

        def slashPos (this.findToken(t "/"))
        if (slashPos <= 0) {
            return ""
        }

        def paceTime (trim (substring t 0 slashPos))
        def perPart (trim (substring t (slashPos + 1) (strlen t)))
        if ((strlen paceTime) == 0) {
            return ""
        }
        if ((strlen perPart) == 0) {
            return ""
        }

        def paceSecs (this.parseClockSeconds(paceTime))
        if (paceSecs <= 0.0) {
            return ""
        }

        def per@(optional):DistanceNode
        if (perPart == "km") {
            def oneKm (new DistanceNode)
            oneKm.value = 1.0
            oneKm.unit = "km"
            per = oneKm
        } {
            def perDist (this.parseDistanceToken(perPart))
            if ((strlen perDist.unit) > 0) {
                per = perDist
            }
        }

        if (null? per) {
            return ""
        }

        def d (unwrap distance)
        def p (unwrap per)
        if (d.unit != p.unit) {
            return ""
        }
        if (p.value <= 0.0) {
            return ""
        }

        def ratio (d.value / p.value)
        if (ratio <= 0.0) {
            return ""
        }

        def outSecs (paceSecs * ratio)
        if (outSecs <= 0.0) {
            return ""
        }

        return ("" + outSecs + "s")
    }

    fn parsePaceQuantity:QuantityNode (paceToken:string) {
        def out (new QuantityNode)
        out.raw = (trim paceToken)
        def t out.raw
        if ((strlen t) == 0) {
            return out
        }

        def slashPos (this.findToken(t "/"))
        if (slashPos <= 0) {
            return out
        }

        def paceTime (trim (substring t 0 slashPos))
        def perPart (trim (substring t (slashPos + 1) (strlen t)))
        if ((strlen paceTime) == 0) {
            return out
        }
        if ((strlen perPart) == 0) {
            return out
        }

        def paceSecs (this.parseClockSeconds(paceTime))
        if (paceSecs <= 0.0) {
            return out
        }

        if (perPart == "100m") {
            out.value = paceSecs
            out.unit = "s/100m"
            return out
        }

        def isKm:boolean false
        if (perPart == "km") {
            isKm = true
        }
        if (isKm) {
            out.value = (3600.0 / paceSecs)
            out.unit = "km/h"
            return out
        }

        def perDist (this.parseDistanceToken(perPart))
        if ((strlen perDist.unit) > 0) {
            if (perDist.unit == "m") {
                if (perDist.value > 0.0) {
                    out.value = (paceSecs * (100.0 / perDist.value))
                    out.unit = "s/100m"
                    return out
                }
            }
        }

        return out
    }

    fn parseRepeatDistance:boolean (token:string node:MoveNode) {
        def t (trim token)
        if ((strlen t) == 0) {
            return false
        }

        def xPos (this.findToken(t "x"))
        if (xPos <= 0) {
            return false
        }

        def left (trim (substring t 0 xPos))
        def right (trim (substring t (xPos + 1) (strlen t)))
        if ((strlen left) == 0) {
            return false
        }
        if ((strlen right) == 0) {
            return false
        }

        def countOpt (str2int left)
        if (null? countOpt) {
            return false
        }

        def dNode (this.parseDistanceToken(right))
        if ((strlen dNode.unit) == 0) {
            return false
        }

        node.count = (unwrap countOpt)
        node.distance = dNode
        return true
    }

    fn parseIntOrRange:IntRangeParseNode (token:string) {
        def out (new IntRangeParseNode)
        def t (trim token)
        if ((strlen t) == 0) {
            return out
        }

        def dashPos (this.findToken(t "-"))
        if (dashPos > 0) {
            def left (trim (substring t 0 dashPos))
            def right (trim (substring t (dashPos + 1) (strlen t)))
            if ((strlen left) == 0) {
                return out
            }
            if ((strlen right) == 0) {
                return out
            }

            def minOpt (str2int left)
            def maxOpt (str2int right)
            if ((!null? minOpt) && (!null? maxOpt)) {
                out.ok = true
                out.min = (unwrap minOpt)
                out.max = (unwrap maxOpt)
            }
            return out
        }

        def oneOpt (str2int t)
        if (!null? oneOpt) {
            out.ok = true
            out.min = (unwrap oneOpt)
        }
        return out
    }

    fn parseRepeatsToken:RepeatsNode (token:string) {
        def out (new RepeatsNode)
        out.raw = (trim token)

        def t (trim token)
        if ((strlen t) == 0) {
            return out
        }

        def xPos (this.findToken(t "x"))
        if (xPos > 0) {
            def left (trim (substring t 0 xPos))
            def right (trim (substring t (xPos + 1) (strlen t)))
            def setParsed (this.parseIntOrRange(left))
            def repParsed (this.parseIntOrRange(right))
            if (setParsed.ok && repParsed.ok) {
                out.sets = setParsed.min
                if (!null? setParsed.max) {
                    out.setsMax = (unwrap setParsed.max)
                }
                out.reps = repParsed.min
                if (!null? repParsed.max) {
                    out.repsMax = (unwrap repParsed.max)
                }
            }
            return out
        }

        def repOnly (this.parseIntOrRange(t))
        if (repOnly.ok) {
            out.reps = repOnly.min
            if (!null? repOnly.max) {
                out.repsMax = (unwrap repOnly.max)
            }
        }

        return out
    }

    fn parseMoveQuantities:void (segment:string node:MoveNode preferRecovery:boolean) {
        def seg (trim segment)
        if ((strlen seg) == 0) {
            return
        }

        def tokens (strsplit seg " ")
        def sawSlash@(mutable):boolean false
        for tokens tok:string i {
            def t (trim tok)
            if ((strlen t) == 0) {
                continue
            }

            if (t == "/") {
                sawSlash = true
                continue
            }

            def parsedRepDist (this.parseRepeatDistance(t node))
            if (parsedRepDist) {
                continue
            }

            def dNode (this.parseDistanceToken(t))
            if ((strlen dNode.unit) > 0) {
                if (null? node.distance) {
                    node.distance = dNode
                }
                continue
            }

            def dur (this.parseDurationToken(t))
            if ((strlen dur) > 0) {
                if (preferRecovery || sawSlash) {
                    if (null? node.recovery) {
                        node.recovery = dur
                        def q (this.parseDurationQuantity(dur))
                        if ((strlen q.unit) > 0) {
                            node.recoveryQuantity = q
                        }
                    }
                } {
                    if (null? node.duration) {
                        node.duration = dur
                        def q (this.parseDurationQuantity(dur))
                        if ((strlen q.unit) > 0) {
                            node.durationQuantity = q
                        }
                    }
                }
                sawSlash = false
                continue
            }

            def hrQ (this.parseSuffixedQuantity(t "bpm"))
            if ((strlen hrQ.unit) > 0) {
                if (null? node.hrQuantity) {
                    node.hrQuantity = hrQ
                }
                continue
            }

            def intensityQ (this.parseSuffixedQuantity(t "%"))
            if ((strlen intensityQ.unit) > 0) {
                if (null? node.intensityQuantity) {
                    node.intensityQuantity = intensityQ
                }
                if (null? node.intensity) {
                    node.intensity = t
                }
                continue
            }

            def zPrefix (this.startsWith(t "Z"))
            if (zPrefix) {
                if (null? node.intensity) {
                    node.intensity = t
                }
                continue
            }
        }
    }

    fn parseMoveHeadQuantities:void (segment:string node:MoveNode) {
        def seg (trim segment)
        if ((strlen seg) == 0) {
            return
        }

        def tokens (strsplit seg " ")
        def sawSlash@(mutable):boolean false
        def sawDuration@(mutable):boolean false
        for tokens tok:string i {
            def t (trim tok)
            if ((strlen t) == 0) {
                continue
            }

            if (t == "/") {
                sawSlash = true
                continue
            }

            def parsedRepDist (this.parseRepeatDistance(t node))
            if (parsedRepDist) {
                continue
            }

            def dNode (this.parseDistanceToken(t))
            if ((strlen dNode.unit) > 0) {
                if (null? node.distance) {
                    node.distance = dNode
                }
                continue
            }

            def dur (this.parseDurationToken(t))
            if ((strlen dur) > 0) {
                if (sawDuration == false) {
                    if (null? node.duration) {
                        node.duration = dur
                        def q (this.parseDurationQuantity(dur))
                        if ((strlen q.unit) > 0) {
                            node.durationQuantity = q
                        }
                    }
                    sawDuration = true
                } {
                    if (sawSlash) {
                        if (null? node.recovery) {
                            node.recovery = dur
                            def q2 (this.parseDurationQuantity(dur))
                            if ((strlen q2.unit) > 0) {
                                node.recoveryQuantity = q2
                            }
                        }
                    }
                }
                sawSlash = false
                continue
            }

            def hrQ (this.parseSuffixedQuantity(t "bpm"))
            if ((strlen hrQ.unit) > 0) {
                if (null? node.hrQuantity) {
                    node.hrQuantity = hrQ
                }
                continue
            }

            def intensityQ (this.parseSuffixedQuantity(t "%"))
            if ((strlen intensityQ.unit) > 0) {
                if (null? node.intensityQuantity) {
                    node.intensityQuantity = intensityQ
                }
                if (null? node.intensity) {
                    node.intensity = t
                }
                continue
            }

            def zPrefix (this.startsWith(t "Z"))
            if (zPrefix) {
                if (null? node.intensity) {
                    node.intensity = t
                }
                continue
            }
        }
    }

    fn parseSplitNode:SplitNode (line:string) {
        def n (new SplitNode)
        n.raw = line

        def parts (strsplit line "|")
        def head (trim (itemAt parts 0))

        def tokens (strsplit head " ")
        for tokens tok:string i {
            def t (trim tok)
            if ((strlen t) == 0) {
                continue
            }

            if (this.startsWith(t "[[")) {
                push n.customFields t
                continue
            }

            def dNode (this.parseDistanceToken(t))
            if ((strlen dNode.unit) > 0) {
                if (null? n.distance) {
                    n.distance = dNode
                }
                continue
            }

            def bpmPos (this.findToken(t "bpm"))
            if (bpmPos > 0) {
                def hrPart (trim (substring t 0 bpmPos))
                def hrOpt (str2int hrPart)
                if (!null? hrOpt) {
                    n.hr = (unwrap hrOpt)
                    continue
                }
            }

            def pace100Pos (this.findToken(t "/100m"))
            def paceKmPos (this.findToken(t "/km"))
            if ((pace100Pos > 0) || (paceKmPos > 0)) {
                n.pace = t
                def paceQ (this.parsePaceQuantity(t))
                if ((strlen paceQ.unit) > 0) {
                    n.paceQuantity = paceQ
                }
                if (null? n.duration) {
                    def inferred (this.inferDurationFromPace(t n.distance))
                    if ((strlen inferred) > 0) {
                        n.duration = inferred
                    }
                }
                continue
            }

            def dur (this.parseDurationToken(t))
            if ((strlen dur) > 0) {
                if (null? n.duration) {
                    n.duration = dur
                }
                continue
            }
        }

        if (null? n.pace) {
            def headP100 (this.findToken(head "/100m"))
            def headPkm (this.findToken(head "/km"))
            if ((headP100 > 0) || (headPkm > 0)) {
                n.pace = head
                def paceQ2 (this.parsePaceQuantity(head))
                if ((strlen paceQ2.unit) > 0) {
                    n.paceQuantity = paceQ2
                }
            }
        }

        if (null? n.hr) {
            def bpmAllPos (this.findToken(head "bpm"))
            if (bpmAllPos > 0) {
                def start@(mutable):int (bpmAllPos - 1)
                while (start >= 0) {
                    def ch (charAt head start)
                    if ((ch >= (ccode "0")) && (ch <= (ccode "9"))) {
                        start = start - 1
                    } {
                        start = start + 1
                        break
                    }
                }
                if (start < 0) {
                    start = 0
                }
                def hrPart (trim (substring head start bpmAllPos))
                if ((strlen hrPart) > 0) {
                    def hrOpt (str2int hrPart)
                    if (!null? hrOpt) {
                        n.hr = (unwrap hrOpt)
                    }
                }
            }
        }

        if ((array_length parts) > 1) {
            remove_index parts 0
            def noteTxt (trim (join parts "|"))
            if ((strlen noteTxt) > 0) {
                n.note = noteTxt
            }
        }

        return n
    }

    fn childDepth:int (line:string) {
        def len (strlen line)
        if (len == 0) {
            return 0
        }

        def i@(mutable):int 0
        while (i < len) {
            def ch (charAt line i)
            if (ch == (ccode " ")) {
                i = i + 1
            } {
                break
            }
        }

        def depth@(mutable):int 0
        while (i < len) {
            def ch (charAt line i)
            if (ch == (ccode ">")) {
                depth = depth + 1
                i = i + 1
                while (i < len) {
                    def sp (charAt line i)
                    if (sp == (ccode " ")) {
                        i = i + 1
                    } {
                        break
                    }
                }
            } {
                break
            }
        }

        return depth
    }

    fn stripChildPrefix:string (line:string) {
        def len (strlen line)
        def i@(mutable):int 0

        while (i < len) {
            def ch (charAt line i)
            if ((ch == (ccode " ")) || (ch == (ccode ">"))) {
                i = i + 1
            } {
                break
            }
        }

        return (trim (substring line i len))
    }

    fn parseTagsNode:TagsNode (line:string) {
        def t (new TagsNode)
        def rest (trim (substring line 4 (strlen line)))
        def parts (strsplit rest ",")
        for parts one:string i {
            def v (trim one)
            if ((strlen v) > 0) {
                push t.tags v
            }
        }
        return t
    }

    fn parseEmojisNode:EmojisNode (line:string) {
        def n (new EmojisNode)
        n.emojis = (trim (substring line 6 (strlen line)))
        return n
    }

    fn parseSummaryNode:SummaryNode (line:string) {
        def n (new SummaryNode)
        n.text = (trim (substring line 7 (strlen line)))
