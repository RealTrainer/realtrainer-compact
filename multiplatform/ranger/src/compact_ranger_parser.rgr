        return n
    }

    fn parseSportNode:MoveNode (line:string sportToken:string) {
        def node (new MoveNode)
        node.sport = sportToken

        def parts (strsplit line "|")
        def head (trim (itemAt parts 0))
        def headRest ""
        def sportLen (strlen sportToken)
        if ((strlen head) > sportLen) {
            headRest = (trim (substring head sportLen (strlen head)))
        }

        this.parseMoveHeadQuantities(headRest node)

        if ((array_length parts) > 1) {
            def i@(mutable):int 1
            while (i < (array_length parts)) {
                def seg (trim (itemAt parts i))
                def preferRecovery:boolean true
                if (i == 1) {
                    preferRecovery = false
                }
                this.parseMoveQuantities(seg node preferRecovery)
                i = i + 1
            }

            remove_index parts 0
            def noteTxt (trim (join parts "|"))
            if ((strlen noteTxt) > 0) {
                node.note = noteTxt
            }
        }

        return node
    }

    fn createWorkout:WorkoutNode (title:string date:DateValueNode hasDate:boolean doc:DocumentNode) {
        def w (new WorkoutNode)
        w.title = title
        if (hasDate) {
            w.date = date
        }
        push doc.workouts w
        return w
    }

    fn ensureCurrent:WorkoutNode (current@(optional):WorkoutNode doc:DocumentNode) {
        if (!null? current) {
            return (unwrap current)
        }
        def emptyDate (new DateValueNode)
        return (this.createWorkout("Untitled" emptyDate false doc))
    }

    fn parse:DocumentNode (input:string) {
        def doc (new DocumentNode)
        def lines (strsplit input "\n")
        def current@(optional):WorkoutNode
        def currentMove@(optional):MoveNode
        def currentSplit@(optional):SplitNode

        for lines rawLine:string i {
            def line (trim rawLine)
            if ((strlen line) == 0) {
                continue
            }

            def depth (this.childDepth(line))
            if (depth > 0) {
                def payload (this.stripChildPrefix(line))
                if ((strlen payload) == 0) {
                    continue
                }

                if (depth == 1) {
                    if (!null? currentMove) {
                        def s (this.parseSplitNode(payload))
                        def m (unwrap currentMove)
                        push m.splits s
                        currentSplit = s
                        continue
                    }
                }

                if (depth > 1) {
                    if (!null? currentSplit) {
                        def s2 (this.parseSplitNode(payload))
                        def ps (unwrap currentSplit)
                        push ps.splits s2
                        currentSplit = s2
                        continue
                    }
                }

                def wChild (this.ensureCurrent(current doc))
                def unkChild (new UnknownNode)
                unkChild.raw = line
                push wChild.content unkChild
                current = wChild
                continue
            }

            if (this.startsWith(line "Format ")) {
                doc.format = (trim (substring line 7 (strlen line)))
                continue
            }

            if (this.startsWith(line "##")) {
                def title (trim (substring line 2 (strlen line)))
                if ((strlen title) == 0) {
                    title = "Untitled"
                }
                def emptyDate (new DateValueNode)
                current = (this.createWorkout(title emptyDate false doc))
                continue
            }

            def hashPos (this.findToken(line "##"))
            if (hashPos >= 0) {
                def date (this.parseDateFromHeader(line hashPos))
                def title (this.parseTitleFromHeader(line hashPos))
                def hasDate:boolean false
                if (date.unknown == false) {
                    hasDate = true
                }
                current = (this.createWorkout(title date hasDate doc))
                continue
            }

            if (this.startsWith(line "Tags ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseTagsNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Emojis ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseEmojisNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Summary ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseSummaryNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Text ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseTextNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Derived ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseDerivedNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Exercise ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseExerciseNode(line 8))
                current = w
                continue
            }

            if (this.startsWith(line "Phase")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parsePhaseNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Section ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseSectionNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Time ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseDurationNode(line 5))
                current = w
                continue
            }

            if (this.startsWith(line "Duration ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseDurationNode(line 9))
                current = w
                continue
            }

            if (this.startsWith(line "Contacts ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseContactsNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Lift ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseExerciseNode(line 4))
                current = w
                continue
            }

            if (this.startsWith(line "Reminder ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseReminderNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Feeling")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseFeelingNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Pain ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parsePainNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Vitals ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseVitalsNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "Location ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseLocationNode(line))
                current = w
                continue
            }

            if (this.startsWith(line "URL ")) {
                def w (this.ensureCurrent(current doc))
                push w.content (this.parseUrlNode(line))
                current = w
                continue
            }

            def sportToken (this.detectSportToken(line))
            if ((strlen sportToken) > 0) {
                def w (this.ensureCurrent(current doc))
                def moveNode (this.parseSportNode(line sportToken))
                push w.content moveNode
                current = w
                currentMove = moveNode
                continue
            }

            def w (this.ensureCurrent(current doc))
            def unk (new UnknownNode)
            unk.raw = line
            push w.content unk
            current = w
        }

        return doc
    }

    sfn parseText:DocumentNode (input:string) {
        def parser (new CompactAstParser)
        return (parser.parse(input))
    }
}
