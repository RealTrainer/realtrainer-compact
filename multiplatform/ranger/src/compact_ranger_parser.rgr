class MoveNode {
    Extends(AstNode)

    def sport:string "juoksu"
    def sets:int 1
    def count:int 1
    def countMax@(optional):int
    def distance@(optional):DistanceNode
    def duration@(optional):string
    def durationQuantity@(optional):QuantityNode
    def steps@(optional):int
    def intensity@(optional):string
    def intensityQuantity@(optional):QuantityNode
    def hrQuantity@(optional):QuantityNode
    def recovery@(optional):string
    def recoveryQuantity@(optional):QuantityNode
    def note@(optional):string
    def description@(optional):string
    def customFields:[string]
    def splits:[AstNode]

    Constructor () {
        type = "move"
    }

    fn toJSONString@(override):string () {
        def fields:[string]
        CompactAstJson.addStringField(fields "type" type)
        CompactAstJson.addStringField(fields "sport" sport)
        CompactAstJson.addIntField(fields "count" count)
        CompactAstJson.addOptionalIntField(fields "countMax" countMax)
        if (!null? distance) {
            CompactAstJson.addDistanceField(fields "distance" (unwrap distance))
        }
        CompactAstJson.addOptionalStringField(fields "duration" duration)
        if (!null? durationQuantity) {
            CompactAstJson.addQuantityField(fields "durationQuantity" (unwrap durationQuantity))
        }
        CompactAstJson.addOptionalStringField(fields "intensity" intensity)
        if (!null? intensityQuantity) {
            CompactAstJson.addQuantityField(fields "intensityQuantity" (unwrap intensityQuantity))
        }
        if (!null? hrQuantity) {
            CompactAstJson.addQuantityField(fields "hrQuantity" (unwrap hrQuantity))
        }
        CompactAstJson.addOptionalStringField(fields "recovery" recovery)
        if (!null? recoveryQuantity) {
            CompactAstJson.addQuantityField(fields "recoveryQuantity" (unwrap recoveryQuantity))
        }
        CompactAstJson.addOptionalStringField(fields "note" note)
        CompactAstJson.addNodeArrayField(fields "splits" splits)
        return (CompactAstJson.jsonObject(fields))
    }
}

