    fn parseDurationNode:DurationNode (line:string prefixLen:int) {
        def n (new DurationNode)
        n.raw = line
        n.text = (trim (substring line prefixLen (strlen line)))

        def parts (strsplit n.text "|")
        if ((array_length parts) > 0) {
            def head (trim (itemAt parts 0))
            def q (this.parseDurationQuantity(head))
            if ((strlen q.unit) == 0) {
                def compactHead (join (strsplit head " ") "")
                q = (this.parseDurationQuantity(compactHead))
            }
            if ((strlen q.unit) > 0) {
                n.durationQuantity = q
            }

            if ((array_length parts) > 1) {
                remove_index parts 0
                def commentTxt (trim (join parts "|"))
                if ((strlen commentTxt) > 0) {
                    n.comment = commentTxt
                }
            }
        }
        return n
    }

    fn parseContactsNode:ContactsNode (line:string) {
        def n (new ContactsNode)
        n.raw = line
        n.text = (trim (substring line 9 (strlen line)))

        def parts (strsplit n.text "|")
        if ((array_length parts) > 0) {
            def head (trim (itemAt parts 0))
            def rep (this.parseRepeatsToken(head))
            if ((!null? rep.reps) || (!null? rep.sets)) {
                n.repeats = rep
            }

            if ((array_length parts) > 1) {
                remove_index parts 0
                def commentTxt (trim (join parts "|"))
                if ((strlen commentTxt) > 0) {
                    n.comment = commentTxt
                }
            }
        }

        return n
    }

    fn parseFeelingNode:FeelingNode (line:string) {
        def n (new FeelingNode)
        n.raw = line
        def rest (trim (substring line 7 (strlen line)))
        def parts (strsplit rest "|")

        if ((array_length parts) > 0) {
            def valuePart (trim (itemAt parts 0))
            if (this.startsWith(valuePart "RPE:")) {
                n.scale = "rpe"
                def rpeOpt (str2double (trim (substring valuePart 4 (strlen valuePart))))
                if (!null? rpeOpt) {
                    n.value = (unwrap rpeOpt)
                }
            } {
                def slashPos (this.findToken(valuePart "/"))
                if (slashPos > 0) {
                    def left (trim (substring valuePart 0 slashPos))
                    def valOpt (str2double left)
                    if (!null? valOpt) {
                        n.value = (unwrap valOpt)
                    }
                } {
                    if ((strlen valuePart) > 0) {
                        def valOpt (str2double valuePart)
                        if (!null? valOpt) {
                            n.value = (unwrap valOpt)
                        }
                    }
                }
            }
        }

        if ((array_length parts) > 1) {
            remove_index parts 0
            def desc (trim (join parts "|"))
            if ((strlen desc) > 0) {
                n.description = desc
            }
        }

        return n
    }

    fn parsePainNode:PainNode (line:string) {
        def n (new PainNode)
        n.raw = line
        def rest (trim (substring line 4 (strlen line)))
        def parts (strsplit rest "|")
        if ((array_length parts) > 0) {
            def body (trim (itemAt parts 0))
            if ((strlen body) > 0) {
                n.bodyPart = body
            }
        }
        if ((array_length parts) > 1) {
            def sevAndDesc (trim (itemAt parts 1))
            def slashPos (this.findToken(sevAndDesc "/"))
            if (slashPos > 0) {
                def sevStr (trim (substring sevAndDesc 0 slashPos))
                def sevOpt (str2double sevStr)
                if (!null? sevOpt) {
                    n.severity = (unwrap sevOpt)
                }
            }
            if ((array_length parts) > 2) {
                remove_index parts 0
                remove_index parts 0
                def desc (trim (join parts "|"))
                if ((strlen desc) > 0) {
                    n.description = desc
                }
            }
        }
        return n
    }

