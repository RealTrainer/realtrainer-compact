    def distance@(optional):DistanceNode
    def duration@(optional):string
    def durationMax@(optional):string
    def recovery@(optional):string
    def recoveryQuantity@(optional):QuantityNode
    def loadValue@(optional):double
    def loadUnit@(optional):string

    fn toJSONString:string () {
        def fields:[string]
        CompactAstJson.addStringField(fields "raw" raw)
        CompactAstJson.addOptionalIntField(fields "sets" sets)
        CompactAstJson.addOptionalIntField(fields "setsMax" setsMax)
        CompactAstJson.addOptionalIntField(fields "reps" reps)
        CompactAstJson.addOptionalIntField(fields "repsMax" repsMax)
        CompactAstJson.addOptionalBooleanField(fields "repeatsUnknown" repeatsUnknown)
        if (!null? distance) {
            CompactAstJson.addDistanceField(fields "distance" (unwrap distance))
        }
        CompactAstJson.addOptionalStringField(fields "duration" duration)
        CompactAstJson.addOptionalStringField(fields "durationMax" durationMax)
        CompactAstJson.addOptionalStringField(fields "recovery" recovery)
        if (!null? recoveryQuantity) {
            CompactAstJson.addQuantityField(fields "recoveryQuantity" (unwrap recoveryQuantity))
        }
        CompactAstJson.addOptionalDoubleField(fields "loadValue" loadValue)
        CompactAstJson.addOptionalStringField(fields "loadUnit" loadUnit)
        return (CompactAstJson.jsonObject(fields))
    }
}

