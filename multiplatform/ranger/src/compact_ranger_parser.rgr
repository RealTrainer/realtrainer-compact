    }

    fn parseDerivedNode:DerivedNode (line:string) {
        def n (new DerivedNode)
        n.raw = line
        def rest (trim (substring line 7 (strlen line)))
        def tokens (strsplit rest " ")
        if ((array_length tokens) > 0) {
            n.name = (trim (itemAt tokens 0))
        }
        if ((array_length tokens) > 1) {
            def valueUnit (trim (itemAt tokens 1))
            def vuParts (strsplit valueUnit "|")
            if ((array_length vuParts) > 0) {
                def numOpt (str2double (trim (itemAt vuParts 0)))
                if (!null? numOpt) {
                    n.value = (unwrap numOpt)
                }
            }
            if ((array_length vuParts) > 1) {
                n.unit = (trim (itemAt vuParts 1))
            }
        }
        if ((array_length tokens) > 2) {
            remove_index tokens 0
            remove_index tokens 0
            def note (trim (join tokens " "))
            if ((strlen note) > 0) {
                n.note = note
            }
        }
        return n
    }

    fn parseExerciseAttemptToken:ExerciseAttemptNode (token:string) {
        def out (new ExerciseAttemptNode)
        out.raw = (trim token)
        def t out.raw
        if ((strlen t) == 0) {
            return out
        }

        def atPos (this.findToken(t "@"))
        def left t
        def right ""
        if (atPos >= 0) {
            left = (trim (substring t 0 atPos))
            right = (trim (substring t (atPos + 1) (strlen t)))
        }

        ; Parse optional recovery suffix before weight, for example:
        ; 3x40m/2min@32kg or 3x30/10s@20kg
        if ((strlen left) > 0) {
            def slashPos (this.findToken(left "/"))
            if ((slashPos > 0) && (slashPos < (strlen left) - 1)) {
                def leftMain (trim (substring left 0 slashPos))
                def recoveryPart (trim (substring left (slashPos + 1) (strlen left)))
                if ((strlen recoveryPart) > 0) {
                    out.recovery = recoveryPart
                    def recQ (this.parseDurationQuantity(recoveryPart))
                    if ((strlen recQ.unit) > 0) {
                        out.recoveryQuantity = recQ
                    }
                    left = leftMain
                }
            }
        }

        if ((strlen left) > 0) {
            def leftParts (strsplit left "x")
            if ((array_length leftParts) > 1) {
                def setPart (trim (itemAt leftParts 0))
                def setRange (this.parseIntOrRange(setPart))
                if (setRange.ok) {
                    out.sets = setRange.min
                    if (!null? setRange.max) {
                        out.setsMax = (unwrap setRange.max)
                    }
                }

                def repPart (trim (itemAt leftParts 1))
                def repDuration (this.parseDurationRangeToken(repPart))
                if (repDuration.ok) {
                    out.duration = (unwrap repDuration.min)
                    if (!null? repDuration.max) {
                        out.durationMax = (unwrap repDuration.max)
                    }
                } {
                    def repDistance (this.parseDistanceRangeToken(repPart))
                    if ((strlen repDistance.unit) > 0) {
                        out.distance = repDistance
                    } {
                    def repRange (this.parseIntOrRange(repPart))
                    if (repRange.ok) {
                        out.reps = repRange.min
                        if (!null? repRange.max) {
                            out.repsMax = (unwrap repRange.max)
                        }
                    } {
                        if (repPart == "?") {
                            out.repeatsUnknown = true
                        } {
                            ; support shorthand like 8x60kg => sets + load
                            def repLen (strlen repPart)
                            def repSplitPos@(mutable):int repLen
                            def j@(mutable):int 0
                            while (j < repLen) {
                                def repCh (charAt repPart j)
                                def repIsNum:boolean false
                                if ((repCh >= (ccode "0")) && (repCh <= (ccode "9"))) {
                                    repIsNum = true
                                }
                                if ((repCh == (ccode ".")) || (repCh == (ccode "-"))) {
                                    repIsNum = true
                                }
                                if (repIsNum == false) {
                                    repSplitPos = j
                                    j = repLen
                                } {
                                    j = j + 1
                                }
                            }

                            def repValuePart (trim (substring repPart 0 repSplitPos))
                            def repUnitPart (trim (substring repPart repSplitPos repLen))
                            if (((strlen repValuePart) > 0) && ((strlen repUnitPart) > 0)) {
                                def looksLikeLoad:boolean false
                                if (this.startsWith(repUnitPart "kg")) {
                                    looksLikeLoad = true
                                }
                                if (this.startsWith(repUnitPart "lb")) {
                                    looksLikeLoad = true
                                }
                                if (this.startsWith(repUnitPart "bw")) {
                                    looksLikeLoad = true
                                }
                                if (this.startsWith(repUnitPart "bodyweight")) {
                                    looksLikeLoad = true
                                }
                                if (this.startsWith(repUnitPart "tanko")) {
                                    looksLikeLoad = true
                                }
                                if (looksLikeLoad) {
                                    def repLoadOpt (str2double repValuePart)
                                    if (!null? repLoadOpt) {
                                        out.loadValue = (unwrap repLoadOpt)
                                        out.loadUnit = repUnitPart
                                    }
                                }
                            }
                        }
                    }
                    }
                }

                if ((array_length leftParts) > 2) {
                    def distPart (trim (itemAt leftParts 2))
                    def dRange (this.parseDistanceRangeToken(distPart))
                    if ((strlen dRange.unit) > 0) {
                        out.distance = dRange
                    }
                }
            } {
                def leftDuration (this.parseDurationRangeToken(left))
                if (leftDuration.ok) {
                    out.duration = (unwrap leftDuration.min)
                    if (!null? leftDuration.max) {
                        out.durationMax = (unwrap leftDuration.max)
                    }
                } {
                    def repRange (this.parseIntOrRange(left))
                    if (repRange.ok) {
                        out.reps = repRange.min
                        if (!null? repRange.max) {
                            out.repsMax = (unwrap repRange.max)
                        }
                    } {
                        if (left == "?") {
                            out.repeatsUnknown = true
                        }
                    }
                }
            }
        }

        if ((strlen right) > 0) {
            def rLen (strlen right)
            def splitPos@(mutable):int rLen
            def i@(mutable):int 0
            while (i < rLen) {
                def ch (charAt right i)
                def isNum:boolean false
                if ((ch >= (ccode "0")) && (ch <= (ccode "9"))) {
                    isNum = true
                }
                if ((ch == (ccode ".")) || (ch == (ccode "-"))) {
                    isNum = true
                }
                if (isNum == false) {
                    splitPos = i
                    i = rLen
                } {
                    i = i + 1
                }
            }

            def valuePart (trim (substring right 0 splitPos))
            def unitPart (trim (substring right splitPos rLen))
            if ((strlen valuePart) > 0) {
                def valueOpt (str2double valuePart)
                if (!null? valueOpt) {
                    out.loadValue = (unwrap valueOpt)
                }
            }
            if ((strlen unitPart) > 0) {
                out.loadUnit = unitPart
            }
            if (null? out.loadValue) {
                if ((strlen right) > 0) {
                    out.loadUnit = right
                }
            }
        }

        return out
    }

    fn parseExerciseNode:ExerciseNode (line:string prefixLen:int) {
        def n (new ExerciseNode)
        n.raw = line
        def rest (trim (substring line prefixLen (strlen line)))
        def parts (strsplit rest "|")
        if ((array_length parts) > 0) {
            n.name = (trim (itemAt parts 0))
        }
        if ((array_length parts) > 1) {
            def specTxt (trim (itemAt parts 1))
            if ((strlen specTxt) > 0) {
                n.spec = specTxt
            }

            if ((array_length parts) > 2) {
                remove_index parts 0
                remove_index parts 0
                def commentTxt (trim (join parts "|"))
                if ((strlen commentTxt) > 0) {
                    n.comment = commentTxt
                }
            }

            def composedNote ""
            if (!null? n.spec) {
                composedNote = (unwrap n.spec)
            }
            if (!null? n.comment) {
                if ((strlen composedNote) > 0) {
                    composedNote = (composedNote + " | " + (unwrap n.comment))
                } {
                    composedNote = (unwrap n.comment)
                }
            }
            if ((strlen composedNote) > 0) {
                n.note = composedNote
            }

            if (!null? n.spec) {
                def specForSeries (unwrap n.spec)
                def maybeSeriesParts (strsplit specForSeries ",")
                if ((array_length maybeSeriesParts) > 1) {
                    def okSeries@(mutable):boolean true
                    for maybeSeriesParts one:string i {
                        def token (trim one)
                        if ((strlen token) == 0) {
                            okSeries = false
                            continue
                        }

                        def repToken token
                        def atPos (this.findToken(token "@"))
                        if (atPos > 0) {
                            repToken = (trim (substring token 0 atPos))
                        }

                        def xPos (this.findToken(repToken "x"))
                        if (xPos > 0) {
                            repToken = (trim (substring repToken (xPos + 1) (strlen repToken)))
                        }

                        def numOpt (str2int repToken)
                        if (null? numOpt) {
                            okSeries = false
                            continue
                        }

                        push n.repsSeries (unwrap numOpt)
                    }

                    if (okSeries == false) {
                        clear n.repsSeries
                    }
                }

                def attemptParts (strsplit specForSeries ",")
                for attemptParts one:string i {
                    def tok (trim one)
                    if ((strlen tok) == 0) {
                        continue
                    }
                    push n.attempts (this.parseExerciseAttemptToken(tok))
                }
            }
        }
        return n
    }

    fn parsePhaseNode:PhaseNode (line:string) {
        def n (new PhaseNode)
        n.raw = line
        def rest (trim (substring line 5 (strlen line)))
        def parts (strsplit rest "|")
