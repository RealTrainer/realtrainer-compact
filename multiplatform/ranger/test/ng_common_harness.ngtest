Expect 0 json $.children[1].parsed.unit m
Expect 1 json $.children[0].parsed.level 1
Expect 1 json $.children[2].parsed.value 100
Expect 1 json $.children[2].parsed.unit m
Expect 1 json $.children[3].children[0].parsed.minutes 2
Expect 1 json $.children[3].children[0].parsed.seconds 45
