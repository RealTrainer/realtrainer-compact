{
  "name": "@realtrainer/compact-parser",
  "version": "1.0.1",
  "description": "Parser for COMPACT format - a concise text-based DSL for workout tracking, nutrition, expenses, and life logging",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "compact-parse": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "types": "./dist/types.d.ts"
    },
    "./renderers": {
      "import": "./dist/renderers/index.js",
      "require": "./dist/renderers/index.cjs",
      "types": "./dist/renderers/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src/grammar"
  ],
  "scripts": {
    "build": "npm run generate-parser && tsc && npm run copy-assets",
    "build:watch": "tsc --watch",
    "build:dev": "npm run build && npm run link:local",
    "generate-parser": "node generate-parser.mjs",
    "copy-assets": "cp src/parser-generated.js dist/",
    "prepare-dist": "node prepare-dist-package.mjs",
    "build:dist": "npm run build && npm run prepare-dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 vitest run monster",
    "prepublishOnly": "npm run build && npm test",
    "clean": "rm -rf dist",
    "link:local": "npm link",
    "dev": "npm run build && npm run test",
    "parse": "node dist/cli.js"
  },
  "keywords": [
    "parser",
    "peg",
    "pegjs",
    "peggy",
    "dsl",
    "workout",
    "fitness",
    "training",
    "nutrition",
    "life-logging",
    "compact-format"
  ],
  "author": "Tero Tolonen",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/terotolonen/compact-parser.git"
  },
  "bugs": {
    "url": "https://github.com/terotolonen/compact-parser/issues"
  },
  "homepage": "https://github.com/terotolonen/compact-parser#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "peggy": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
