{
  "name": "realtrainer-compact",
  "version": "3.0.0",
  "description": "Parser for COMPACT format - a concise text-based DSL for workout tracking, nutrition, expenses, and life logging",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "compact-parse": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./parser": {
      "types": "./dist/parser-ranger/index.d.ts",
      "import": "./dist/parser-ranger/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "import": "./dist/renderers/index.js",
      "require": "./dist/renderers/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./ui/styles.css": "./dist/ui/compact-ui-react.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:parser-ranger && tsc",
    "build:parser-ranger": "node scripts/sync-parser-from-ranger-v1.mjs",
    "build:all": "npm run build && npm run build:ui && npm run build:extension",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/mcp/server.js --sourcemap",
    "build:mcp:watch": "esbuild src/mcp/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/mcp/server.js --sourcemap --watch",
    "build:watch": "tsc --watch",
    "build:ui": "npm --prefix ui/react run build:lib",
    "build:ui-export": "npm run build:ui && node build-ui-export.mjs",
    "build:extension": "npm --prefix vscode-rtcompact run build:ui",
    "build:dev": "npm run build && npm run link:local",
    "prepare-dist": "node prepare-dist-package.mjs",
    "build:dist": "npm run build && npm run build:ui-export && npm run prepare-dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 vitest run monster",
    "prepublishOnly": "npm run build:dist && npm test",
    "clean": "rm -rf dist",
    "clean:ui": "rm -rf ui/react/dist",
    "link:local": "npm link",
    "dev": "npm run build && npm run test",
    "dev:ui": "npm --prefix ui/react run dev",
    "test:all": "npm test && npm --prefix ui/react run test",
    "parse": "node dist/cli.js",
    "mcp:start": "node dist/mcp/server.js",
    "compact-parity:test": "npm --prefix ../realtrainer/parser-ranger-v1 run compact-parity:test",
    "ranger:parity:minimonster:report": "npm --prefix ../realtrainer/parser-ranger-v1 run ranger:parity:minimonster:report"
  },
  "keywords": [
    "parser",
    "ranger",
    "dsl",
    "workout",
    "fitness",
    "training",
    "nutrition",
    "life-logging",
    "compact-format"
  ],
  "author": "Tero Tolonen",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealTrainer/realtrainer-compact.git"
  },
  "bugs": {
    "url": "https://github.com/RealTrainer/realtrainer-compact/issues"
  },
  "homepage": "https://realtrainer.github.io/realtrainer-compact/",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
